---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/hero_ryggont8.png';
import tuinaManImage from '../../../assets/images/tuina_man.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'Används för att manuellt och varsamt bearbeta de spända musklerna för att lösa upp den fysiska låsningen inifrån och ut. TuiNa mjukar upp stela muskler, ökar energi- och blodcirkulationen i området vilket påskyndar läkningsprocessen.',
        image: tuinaManImage,
        alt: 'TuiNa-massage för att lösa akuta låsningar',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur stimulerar kroppens energisystem för läkning, hjälper kroppen att slappna av och minskar de akuta smärtsignalerna.',
        image: acupunctureImage,
        alt: 'Akupunktur för smärtlindring vid ryggskott',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    }
];

const faqs = [
    {
        question: 'Jag har så ont att jag knappt kan röra mig, kan jag verkligen få behandling?',
        answer: 'Ja, absolut. Vi är vana vid att behandla akuta tillstånd. Behandlingen anpassas helt efter din smärtnivå och rörelseförmåga. Ofta kan vi utföra behandlingen i en position som är så bekväm som möjligt för dig, till exempel sittande eller liggande på sidan.'
    },
    {
        question: 'Hur snabbt kan jag få en tid?',
        answer: 'Vid akuta besvär som ryggskott arbetar vi för att hitta en tid åt dig så snabbt som möjligt, ofta samma dag eller nästkommande vardag. Ring eller maila oss och förklara din situation så gör vi vad vi kan för att ta emot dig direkt.'
    }
];
---

<BaseLayout title="Behandling av Akut Ryggskott i Nyköping, Gnesta och Oxelösund | Effektiv Hjälp | Medidraken">
    
    <SymptomHero
        title="Akut Ryggskott"
        subtitle="Minska Smärta & Återställ Funktion"
        image={heroImage}
        imageAlt="Akut Ryggskott Behandling"
        buttonText="Behandla ryggskott"
        buttonLink="/kontakt"
    >
        Ryggskott kommer ofta plötsligt och kan vara oerhört smärtsamt och begränsande. Det kan bero på orsaker som plötslig överbelastning, stillasittande under längre perioder och bristande hållning och stress.
        
        Genom kinesisk medicinsk behandling mjukar vi upp muskelspänningar och stärker energisystem så att ryggens smärta minskar och normal funktion återställs.
    </SymptomHero>

    <SymptomMethods
        title="Minska Smärta & Få Tillbaka Ryggens Normala Funktion"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Vid ett akut ryggskott är musklerna ofta i kramp och hela området är låst. 
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-6">
            Vi erbjuder två kompletterande tillvägagångssätt för att hjälpa din kropp släppa spänningarna och minska smärtan.
            De kan användas var för sig eller i kombination. 
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            Hör av dig så hittar vi tillsammans det upplägg som passar dig bäst.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Låt oss hjälpa dig med ditt Ryggskott"
        ctaButtonText="Hör av dig och boka behandling"
        ctaSubject="akut-ryggont"
    >
        <p>
            Vi prioriterar akuta besvär som ryggskott. Vår erfarenhet är att många känner att smärtan lättar och att rörligheten börjar komma tillbaka redan efter första behandlingen.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Behandling av Ryggskott"
        faqs={faqs}
    />

</BaseLayout>
