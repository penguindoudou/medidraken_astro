{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node scripts/fetch-courses.js && astro dev",
    "build": "rm -rf dist && node scripts/fetch-courses.js && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "gsc:audit": "node scripts/gsc/audit-canonicalization.js",
    "gsc:cleanup": "node scripts/gsc/submit-canonical-cleanup.js",
    "gsc:cleanup:dry": "node scripts/gsc/submit-canonical-cleanup.js --dry-run",
    "gsc:redirects": "node scripts/gsc/review-redirects.js",
    "gsc:redirects:broken": "node scripts/gsc/review-redirects.js --broken-only",
    "gsc:redirects:ui": "node scripts/gsc/redirects-ui.js",
    "gsc:fetch": "node scripts/gsc/fetch-gsc-queries.js",
    "gsc:analyze": "node scripts/gsc/analyze-gsc-data.js",
    "gsc:alert": "node scripts/gsc/alert.js",
    "gsc:run": "npm run gsc:fetch && npm run gsc:alert && npm run gsc:analyze",
    "gsc:compare": "node scripts/gsc/compare-snapshots.js",
    "gsc:request-index": "node scripts/gsc/request-index.js",
    "gsc:draft": "node scripts/gsc/generate-article-draft.js",
    "gsc:track": "node scripts/gsc/track-queries.js",
    "gsc:action-plan": "node scripts/gsc/action-plan.js",
    "gsc:schema": "node scripts/gsc/audit-schema.js",
    "gsc:log": "node scripts/gsc/update-work-log.js"
  },
  "overrides": {
    "vite": "^8.1.3"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/cloudflare": "^14.1.1",
    "@astrojs/sitemap": "^3.7.1",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^7.0.6",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
