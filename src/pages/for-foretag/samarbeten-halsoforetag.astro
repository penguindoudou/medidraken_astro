---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

import heroImage from '../../assets/images/taichi_in_a_circle_instructor_johannes_teaching_several_white_crane_spreading_its_wings_grass_sunny_weather.jpg';
import card1Image from '../../assets/images/taichi_in_a_circle_several_students_parting_the_wild horses_mane_on_green_grass_sunny_weather.jpg';
import card2Image from '../../assets/images/taichi_johannes_teaching_circle.jpg';
import tuinaImage from '../../assets/images/tuina_head_woman.png';
---

<BaseLayout title="Samarbete för Gym, Spa & Hälsoföretag i Nyköping | Medidraken" description="Vi samarbetar med gym, spa och hälsoföretag i Nyköping. Utöka ert utbud med våra kurser i Qigong, Tai Chi och specialiserade behandlingar.">
    <!-- ======================================= -->
    <!-- Sektion 1: Hero                         -->
    <!-- ======================================= -->
    <section class="hero-section">
        <div class="hero-background">
            <Image src={heroImage} alt="Utöka Ert Erbjudande med Vår Expertis" class="hero-bg-image" />
        </div>

        <div class="hero-content">
            <h1 class="hero-title text-brand-accent">Utöka Ert Erbjudande med Vår Expertis</h1>
            
            <div class="hero-text bg-brand-earth-dark/40 p-4 md:p-6 rounded-lg backdrop-blur-sm border border-white/10">
            <h2 class="hero-subtitle font-semibold">Konkreta Verktyg för Stresshantering och Behandlingar mot Smärta</h2>
                <p class="hero-text mt-2 text-white/95">
                    Driver du ett gym, spa, en yogastudio eller annan hälsoverksamhet? Genom ett samarbete med oss på Medidraken kan ni bredda ert utbud med unik expertis inom <strong>Medicinsk Qigong, Tai Chi och TCM-behandlingar</strong>. Tillsammans kan vi skapa ett mervärde för era befintliga kunder och attrahera nya.
                </p>
            </div>
            
            <div class="mt-6 md:mt-10">
                <a href="#samarbete" class="btn btn-primary-on-dark">
                    Se våra samarbetsmöjligheter
                </a>
            </div>
        </div>
    </section>

    <!-- ======================================= -->
    <!-- Sektion 2: Möjligheter till Samarbete   -->
    <!-- ======================================= -->
    <section id="samarbete" class="bg-white py-16 md:py-24">
        <div class="container-base max-w-6xl">
            <h2 class="text-brand-earth-dark mb-6 text-center text-3xl md:text-5xl">Hur Ett Samarbete Kan Se Ut</h2>
            <p class="text-center text-neutral-700 text-lg max-w-2xl mx-auto mb-12">
                Vi är öppna för olika typer av samarbeten. Såhär kan det se ut:
            </p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
                <!-- Undersektion 1: Kurser & Workshops -->
                <div class="bg-brand-accent/10 rounded-2xl shadow-lg border border-brand-accent/5 flex flex-col group hover:shadow-xl transition-all duration-300">
                    <div class="h-56 overflow-hidden relative rounded-t-2xl">
                        <Image src={card1Image} alt="Exklusiva Kurser & Workshops" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-earth-dark/10 group-hover:bg-brand-earth-dark/0 transition-colors duration-500"></div>
                    </div>
                    
                    <div class="p-8 flex flex-col flex-grow">
                        <span class="text-brand-accent-dark font-semibold tracking-wider uppercase text-xs mb-2">För Kunder & Medlemmar</span>
                        <h3 class="text-2xl font-heading text-brand-earth-dark mb-4">Gäst-Workshops & Kurser</h3>
                        
                        <ul class="space-y-4 mb-4 text-neutral-700">
                            <li class="flex gap-3">
                                <Icon name="taichi_yinyang_gongbu" class="w-6 h-6 text-brand-accent-dark shrink-0" />
                                <span><strong>Medicinsk Qigong & Tai Chi:</strong> Skräddarsydda pass för era medlemmar.</span>
                            </li>
                            <li class="flex gap-3">
                                <Icon name="check-circle" class="w-6 h-6 text-brand-accent-dark shrink-0" />
                                <span><strong>Mervärde:</strong> Unika upplevelser som stärker er position på marknaden.</span>
                            </li>
                        </ul>

                        <div class="mt-auto">
                            <div class="flex gap-4 mb-8 min-h-[3rem]">
                                <a href="/kurser/medicinsk-qigong/" class="text-brand-sky hover:text-brand-sky-dark text-base font-semibold underline underline-offset-4 decoration-brand-sky/30">Läs mer om Qigong</a>
                                <a href="/kurser/tai-chi/" class="text-brand-sky hover:text-brand-sky-dark text-base font-semibold underline underline-offset-4 decoration-brand-sky/30">Läs mer om Tai&nbsp;Chi</a>
                            </div>
                            <a href="/for-foretag/kontakt-offert/?type=samarbete&subtype=kurser#offert" class="btn bg-brand-accent text-brand-earth-dark hover:bg-brand-accent-dark transition-all shadow-md rounded-lg py-3 px-6 font-semibold w-full text-center block">
                                Boka Kurser
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Undersektion 2: TCM-Behandlingar & Massage -->
                <div class="bg-brand-accent/10 rounded-2xl shadow-lg border border-brand-accent/5 flex flex-col group hover:shadow-xl transition-all duration-300">
                    <div class="h-56 overflow-hidden relative rounded-t-2xl">
                        <Image src={tuinaImage} alt="TCM-Behandlingar & Massage" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-earth-dark/10 group-hover:bg-brand-earth-dark/0 transition-colors duration-500"></div>
                    </div>
                    
                    <div class="p-8 flex flex-col flex-grow">
                        <span class="text-brand-accent-dark font-semibold tracking-wider uppercase text-xs mb-2">För Kunder & Personal</span>
                        <h3 class="text-2xl font-heading text-brand-earth-dark mb-4">Behandlingar & Massage</h3>
                        
                        <ul class="space-y-4 mb-4 text-neutral-700">
                            <li class="flex gap-3">
                                <Icon name="heart_pulse" class="w-6 h-6 text-brand-accent-dark shrink-0" />
                                <span><strong>Medicinsk Kinesisk Massage (TuiNa):</strong> Djupgående behandling mot stress och fysisk smärta.</span>
                            </li>
                            <li class="flex gap-3">
                                <Icon name="pin" class="w-6 h-6 text-brand-accent-dark shrink-0" />
                                <span><strong>Pop-up Klinik:</strong> Vi besöker er verksamhet för behandlingar på plats.</span>
                            </li>
                        </ul>

                        <div class="mt-auto">
                            <div class="mb-8 min-h-[3rem]">
                                <a href="/behandling/" class="text-brand-sky hover:text-brand-sky-dark text-base font-semibold underline underline-offset-4 decoration-brand-sky/30 inline-block">Läs mer om behandlingar</a>
                            </div>
                            <a href="/for-foretag/kontakt-offert/?type=samarbete&subtype=behandlingar#offert" class="btn bg-brand-accent text-brand-earth-dark hover:bg-brand-accent-dark transition-all shadow-md rounded-lg py-3 px-6 font-semibold w-full text-center block">
                                Boka Behandlingar
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Undersektion 3: Instruktörsutbildning -->
                <div class="bg-brand-accent/10 rounded-2xl shadow-lg border border-brand-accent/5 flex flex-col group hover:shadow-xl transition-all duration-300">
                    <div class="h-56 overflow-hidden relative rounded-t-2xl">
                        <Image src={card2Image} alt="Instruktörsutbildning" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-earth-dark/10 group-hover:bg-brand-earth-dark/0 transition-colors duration-500"></div>
                    </div>
                    
                    <div class="p-8 flex flex-col flex-grow">
                        <span class="text-brand-accent-dark font-semibold tracking-wider uppercase text-xs mb-2">För Er Personal</span>
                        <h3 class="text-2xl font-heading text-brand-earth-dark mb-4">Instruktörsutbildning</h3>
                        
                        <ul class="space-y-4 mb-4 text-neutral-700">
                            <li class="flex gap-3">
                                <Icon name="taichi_yinyang_mabu" class="w-6 h-6 text-brand-accent-dark shrink-0" />
                                <span><strong>Instruktör:</strong> Leds av Johannes Mao (30+ års erfarenhet).</span>
                            </li>
                            <li class="flex gap-3">
                                <Icon name="calendar_check" class="w-6 h-6 text-brand-accent-dark shrink-0" />
                                <span><strong>Eget Schema:</strong> Utbilda personalen att hålla egna klasser.</span>
                            </li>
                        </ul>

                        <div class="mt-auto">
                            <div class="mb-8 min-h-[3rem]">
                                <a href="/kurser/instruktorsutbildning/" class="text-brand-sky hover:text-brand-sky-dark text-base font-semibold underline underline-offset-4 decoration-brand-sky/30 inline-block">Läs mer om utbildningen</a>
                            </div>
                            <a href="/for-foretag/kontakt-offert/?type=samarbete&subtype=utbildning#offert" class="btn bg-brand-accent text-brand-earth-dark hover:bg-brand-accent-dark transition-all shadow-md rounded-lg py-3 px-6 font-semibold w-full text-center block">
                                Boka Kurs
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ======================================= -->
    <!-- Sektion 3: Praktisk Information         -->
    <!-- ======================================= -->
    <section class="bg-brand-earth-light section-standard text-center">
        <div class="container-base max-w-4xl">
            <div class="max-w-3xl mx-auto mb-16">
                <h2 class="text-brand-earth-dark mb-6 text-3xl md:text-5xl">Låt Oss Skapa Mervärde Tillsammans</h2>
                <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-10">
                    Vi tror på styrkan i lokala samarbeten. Vi kan leverera våra tjänster <strong>på plats hos er eller i våra egna lokaler</strong> i <a href="/for-foretag/kontakt-offert/#mottagningar" class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Nyköping</a>, <a href="/for-foretag/kontakt-offert/#mottagningar" class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Gnesta</a> eller <a href="/for-foretag/kontakt-offert/#mottagningar" class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Oxelösund</a>. 
                    Kontakta oss för ett förutsättningslöst möte där vi kan diskutera hur ett samarbete kan se ut.
                </p>

                <a href="/for-foretag/kontakt-offert/?type=samarbete#offert"
                    class="btn btn-primary-on-dark shadow-lg shadow-black/10 px-10 py-5 text-xl mb-0">
                    Diskutera Samarbete
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
