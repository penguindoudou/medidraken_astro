# Medidraken Environment Variables Template
# Copy this file to .env and fill in the values.

# Cloudflare Web Analytics Token (found in Cloudflare dashboard)
PUBLIC_CLOUDFLARE_TOKEN=YOUR_CLOUDFLARE_TOKEN_HERE
TELEGRAM_CHAT_ID=TELEGRAM_CHAT_ID_HERE
TELEGRAM_BOT_TOKEN=TELEGRAM_BOT_TOKEN
# URL to public Google Sheets CSV export for courses schedule
PUBLIC_COURSES_SHEET_URL=