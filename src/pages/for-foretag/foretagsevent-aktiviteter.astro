---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

// Images
import placeholder1 from '../../assets/images/taichi_johannes_teaching_circle.jpg';
import placeholder2 from '../../assets/images/taich_performance_on_red_stage_group_with_black_and_blue_clothing_blue_oxelösunds_hamn_ab_logoandtext_inbackground_blue_background.jpg';
import heroImage from '../../assets/images/taichi_group_practicing_tai_chi_fan_pubu_in_yangshuo_on_raft_in_river_in_front_of_beautiful_mountains.jpg';
---

<BaseLayout title="Aktiviteter till Företagsevent & Kick-off i Nyköping | Medidraken" description="Boka en unik och stärkande aktivitet till er kick-off eller företagsevent i Nyköping. Prova på Qigong och Tai Chi med erfaren instruktör.">
    <!-- ======================================= -->
    <!-- Sektion 1: Hero                         -->
    <!-- ======================================= -->
    <section class="hero-section">
        <div class="hero-background">
            <Image src={heroImage} alt="Harmoniskt & Återhämtande Företagsaktivitet" class="hero-bg-image" />
        </div>

        <div class="hero-content">
            <h1 class="hero-title text-brand-accent">Harmoniskt & Återhämtande Företagsaktivitet</h1>
            
            <div class="hero-text bg-brand-earth-dark/40 p-4 md:p-6 rounded-lg backdrop-blur-sm border border-white/10">
                <h2 class="hero-subtitle font-semibold">Konkreta Verktyg för Ökad Energinivå och Fokus</h2>
                <p class="hero-text mt-2 text-white/95">
                    Lyft er nästa konferens, kick-off eller hälsodag med ett unikt inslag. Vi erbjuder inspirerande och praktiska aktiviteter som ger deltagarna ny energi, konkreta verktyg för stresshantering och en gemensam upplevelse utöver det vanliga.
                </p>
            </div>
            
            <div class="mt-6 md:mt-10">
                <a href="#tjanster" class="btn btn-primary-on-dark mb-0">
                    Läs mer om våra aktiviteter
                </a>
            </div>
        </div>
    </section>

    <!-- ======================================= -->
    <!-- Sektion 2: Våra Erbjudanden för Event   -->
    <!-- ======================================= -->
    <section id="tjanster" class="bg-white py-16 md:py-24">
        <div class="container-base max-w-6xl">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <h2 class="text-brand-earth-dark mb-6 text-3xl md:text-5xl">Två Exempel på Aktiviteter</h2>
                <p class="text-neutral-700 text-lg">
                    Med hänsyn till syfte och tidsram kan vi skapa aktiviteter som passar ert event. Här är två exempel:
                </p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
                <!-- Kort 1: Workshop -->
                <div class="bg-brand-accent/20 rounded-2xl shadow-lg border border-brand-accent/10 flex flex-col group hover:shadow-xl transition-all duration-300">
                    <div class="h-64 overflow-hidden relative rounded-t-2xl">
                        <Image src={placeholder1} alt="Workshop: Introduktion till Stresshantering" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-earth-dark/10 group-hover:bg-brand-earth-dark/0 transition-colors duration-500"></div>
                    </div>
                    
                    <div class="p-8 flex flex-col flex-grow">
                        <div class="mb-4">
                            <span class="text-brand-accent-dark font-semibold tracking-wider uppercase text-sm">Praktisk Stresshantering & Harmoni</span>
                        </div>
                        <h3 class="text-2xl md:text-3xl font-heading text-brand-earth-dark mb-4">Workshop: Introduktion till Stresshantering</h3>
                        
                        <p class="text-neutral-700 mb-6 leading-relaxed">
                            En interaktiv session med fokus på praktiska övningar. Personalen får lära sig enkla tekniker för att hitta lugnet och behålla fokus under arbetsdagen – inga förkunskaper krävs.
                        </p>

                        <div class="mb-8">
                            <ul class="space-y-3">
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Praktiska övningar för vardagen</span>
                                </li>
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Skräddarsytt upplägg (1–3 timmar)</span>
                                </li>
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Helt nybörjarvänligt</span>
                                </li>
                            </ul>
                        </div>

                        <div class="mt-auto pt-6 border-t border-brand-earth-dark/5">
                            <a href="/for-foretag/kontakt-offert/?type=event&subtype=workshop#offert" class="btn bg-brand-accent text-brand-earth-dark hover:bg-brand-accent-dark hover:-translate-y-1 transition-transform shadow-md rounded-lg py-3 px-6 font-semibold w-full flex justify-center text-center mb-0">
                                Begär Offert för Workshop
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Kort 2: Uppvisning & Prova-på -->
                <div class="bg-brand-accent/20 rounded-2xl shadow-lg border border-brand-accent/10 flex flex-col group hover:shadow-xl transition-all duration-300">
                    <div class="h-64 overflow-hidden relative rounded-t-2xl">
                        <Image src={placeholder2} alt="Uppvisning & Prova-på" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-earth-dark/10 group-hover:bg-brand-earth-dark/0 transition-colors duration-500"></div>
                    </div>
                    
                    <div class="p-8 flex flex-col flex-grow">
                        <div class="mb-4">
                            <span class="text-brand-accent-dark font-semibold tracking-wider uppercase text-sm">Inspirerande & Uppfriskande</span>
                        </div>
                        <h3 class="text-2xl md:text-3xl font-heading text-brand-earth-dark mb-4">Uppvisning & Prova-på</h3>
                        
                        <p class="text-neutral-700 mb-6 leading-relaxed">
                            En vacker Tai Chi-uppvisning följt av ett kort prova-på-pass. Ett uppfriskande avbrott som ger nya samtalsämnen och en skön känsla i kroppen.
                        </p>

                        <div class="mb-8">
                            <ul class="space-y-3">
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Stämningsfull uppvisning (15–20 min)</span>
                                </li>
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Enkelt prova-på-pass (5–15 min)</span>
                                </li>
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Passar alla – inga förkunskaper</span>
                                </li>
                            </ul>
                        </div>

                        <div class="mt-auto pt-6 border-t border-brand-earth-dark/5">
                            <a href="/for-foretag/kontakt-offert/?type=event&subtype=uppvisning#offert" class="btn bg-brand-accent text-brand-earth-dark hover:bg-brand-accent-dark hover:-translate-y-1 transition-transform shadow-md rounded-lg py-3 px-6 font-semibold w-full flex justify-center text-center mb-0">
                                Begär Offert för Uppvisning
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ======================================= -->
    <!-- Sektion 3: Praktisk Information (CTA)   -->
    <!-- ======================================= -->
    <section class="bg-brand-earth-light section-standard text-center">
        <div class="container-base max-w-4xl">

            <!-- Huvud CTA -->
            <div class="max-w-3xl mx-auto mb-16">
                <h2 class="text-brand-earth-dark mb-6 text-3xl md:text-5xl">Harmonisk Gemenskap, Nya Perspektiv, Spektakulär Uppvisning, eller Nåt Annat?</h2>
                <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-10">
                    Berätta vad ni önskar så kommer vi med ett förslag. Vi kan leverera <strong>på plats hos er eller i våra egna lokaler</strong> efter överenskommelse. Kontakta oss för att diskutera ett upplägg och få en offert.
                </p>

                <a href="/for-foretag/kontakt-offert/?type=event#offert"
                    class="btn btn-primary-on-dark shadow-lg shadow-black/10 px-10 py-5 text-xl mb-0">
                    Kontakta Oss
                </a>
            </div>

            <!-- Trust & Info Row (Discrete boxes with icon containers) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 pt-6 mt-0 border-t border-brand-earth-dark/10 max-w-3xl mx-auto">
                
                <!-- Column 1: Platser -->
                <div
                    class="group bg-brand-earth-dark/5 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border-2 border-brand-earth-dark/10 flex flex-col items-start text-left">
                    <div class="flex items-center mb-4">
                        <div
                            class="flex items-center justify-center h-10 w-10 rounded-full bg-brand-earth-dark/25 mr-3">
                            <div class="relative flex h-3 w-3 items-center justify-center">
                                <span
                                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-accent"></span>
                            </div>
                        </div>
                        <span class="font-bold text-brand-earth-dark text-xl">Flexibla Platser</span>
                    </div>
                    <div class="text-neutral-700 leading-relaxed text-sm md:text-base flex-grow">
                        Vi genomför våra tjänster där det passar er bäst. På er arbetsplats eller i våra lokaler i 
                        <a href="/for-foretag/kontakt-offert/#mottagningar"
                            class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Nyköping</a>,
                        <a href="/for-foretag/kontakt-offert/#mottagningar"
                            class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Gnesta</a>
                        och <a href="/kontakt/#mottagningar"
                            class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Oxelösund</a>.
                    </div>
                </div>

                <!-- Column 2: Trygghet -->
                <div
                    class="group bg-brand-earth-dark/5 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border-2 border-brand-earth-dark/10 flex flex-col items-start text-left">
                    <div class="flex items-center mb-4">
                        <div
                            class="flex items-center justify-center h-10 w-10 rounded-full bg-brand-earth-dark/25 text-brand-accent mr-3">
                            <Icon name="shield_health" class="h-6 w-6" />
                        </div>
                        <span class="font-bold text-brand-earth-dark text-xl">Minnesvärd Upplevelse</span>
                    </div>
                    <div class="text-neutral-700 leading-relaxed text-sm md:text-base flex-grow">
                        Vi ser till att er upplevelse blir minnesvärd, professionell och givande för alla deltagare.<br />
                    </div>
                </div>

            </div>
        </div>
    </section>
</BaseLayout>
