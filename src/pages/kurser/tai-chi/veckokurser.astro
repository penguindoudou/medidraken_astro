---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';

// Images
import taichi_hero6Image from '../../../assets/images/taichi_hero6.png';
import taichiCircleImage from '../../../assets/images/taichi_in_a_circle_several_students_parting_the_wild horses_mane_on_green_grass_sunny_weather.jpg';
import johannes_mao_profileImage from '../../../assets/images/johannes_mao_profile.jpg';
import maria_morris_profileImage from '../../../assets/images/maria_morris_profile.jpg';
import magnus_rooth_profileImage from '../../../assets/images/magnus_rooth_profile.jpg';
import { siteConfig } from '../../../data/site.ts';
import { coursesTaiChi } from '../../../data/courses.ts';
import CourseScheduleTable from '../../../components/CourseScheduleTable.astro';

// Filtrera framtida kurser eller de som pågår, och som är av typen Veckokurs
const activeCourses = coursesTaiChi
  .filter(course => new Date(course.lastDate) >= new Date(new Date().setHours(0,0,0,0)))
  .filter(course => course.format?.toLowerCase() === 'veckokurs' || course.format?.toLowerCase() === 'terminskurs');

---

<BaseLayout title="Veckokurser i Tai Chi"
  description="Följ med på våra stärkande veckokurser i Tai Chi i Nyköping och Gnesta. Lär dig grunderna i lugn och ro under en hel termin tillsammans med oss.">
<!-- ======================================= -->
<!-- Sektion 1: Hero                         -->
<!-- ======================================= -->
<section class="hero-section">
    <div class="hero-background">
        <!-- Bild: Tai Chi natur/fokus -->
        <Image src={taichi_hero6Image}
            alt="Veckokurs i Tai Chi - Regelbunden träning för hälsa" class="hero-bg-image" />
    </div>

    <div class="hero-content">
        <h1 class="hero-title text-brand-accent text-balance">Veckokurser i Tai Chi</h1>

        <div class="hero-text bg-brand-earth-dark/40 p-4 md:p-6 rounded-lg backdrop-blur-sm border border-white/10">
            <h2 class="hero-subtitle font-semibold">Regelbunden träning för Balans & Välbefinnande</h2>

            <p class="hero-text mt-2">
                Våra veckokurser ger dig möjlighet att bygga upp din hälsa och Tai Chi-teknik steg för steg under en termin. Genom regelbunden träning en gång i veckan skapar du en hållbar rutin för stresshantering, balans och välmående i din vardag.
            </p>
        </div>

        <div class="mt-6 md:mt-10">
            <a href="#kursstarter" class="btn btn-primary-on-dark">
                Se aktuella veckokurser & anmäl intresse
            </a>
        </div>
    </div>
</section>

<!-- ======================================= -->
<!-- Sektion 2: Fördelarna med en Veckokurs -->
<!-- ======================================= -->
<section class="section-standard bg-white">
    <div class="container-base">
        <div class="text-center mb-12 max-w-3xl mx-auto">
            <h2 class="text-brand-earth">Varför välja en Veckokurs?</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

            <!-- Feature Box 1: Hållbar Hälsorutin -->
            <div class="content-box flex flex-col items-center text-center">
                <div class="flex items-center justify-center h-20 w-20 rounded-full bg-brand-accent/20 mb-4">
                    <Icon name="calendar" class="h-15 w-15 text-brand-accent-dark" stroke-width="1"/>
                </div>

                <h3 class="text-xl font-bold text-neutral-900 mb-3">Hållbar Hälsorutin</h3>
                <p class="text-neutral-700">
                    Träna regelbundet en gång i veckan och bygg upp en hälsorutin i vardagen som stödjer kroppens balans och välbefinnande.
                </p>
            </div>

            <!-- Feature Box 2: Stegvis Utveckling -->
            <div class="content-box flex flex-col items-center text-center">
                <div class="flex items-center justify-center h-20 w-20 rounded-full bg-brand-accent/20 mb-4">
                    <Icon name="taichi_qigong_flow_min" class="h-22 w-22 text-brand-accent-dark" />
                </div>
                <h3 class="text-xl font-bold text-neutral-900 mb-3">Tid för Integration</h3>
                <p class="text-neutral-700">
                    Du får gott om tid mellan varje tillfälle att praktisera och låta kroppsminnet befästa de nya rörelserna.
                </p>
            </div>

            <!-- Feature Box 3: Social Gemenskap -->
            <div class="content-box flex flex-col items-center text-center">
                <div class="flex items-center justify-center h-20 w-20 rounded-full bg-brand-accent/20 mb-4">
                    <!-- Ikon: People/Group -->
                    <svg class="h-12 w-12 text-brand-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                        </path>
                    </svg>
                </div>

                <h3 class="text-xl font-bold text-neutral-900 mb-3">Grundande Gemenskap</h3>
                <p class="text-neutral-700">
                    Träffa likasinnade varje vecka och bli en del av en stödjande och harmonisk träningsgemenskap.
                </p>
            </div>

        </div>
    </div>
</section>

<!-- ======================================= -->
<!-- Sektion 3: Kursupplägg & Innehåll       -->
<!-- ======================================= -->
<section class="section-standard bg-brand-earth-lightest">
    <div class="container-base">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-brand-earth text-center mb-10">Hur en Veckokurs Går Till</h2>

            <div class="bg-brand-accent/10 rounded-xl p-8 md:p-10 shadow-sm border border-neutral-200">

                <!-- Section 1: Upplägget: I praktiken -->
                <div class="mb-12">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                        <!-- Stage 1: Uppvärmning -->
                        <div
                            class="bg-gradient-to-br from-brand-earth/5 to-brand-accent/5 rounded-xl p-6 border-2 border-brand-earth/20 shadow-sm">
                            <div class="flex flex-col items-center text-center h-full">
                                <div
                                    class="flex items-center justify-center h-16 w-16 rounded-full bg-brand-accent text-white mb-4 shadow-md">
                                    <Icon name="taichi_yinyang_mabu" class="h-10 w-10" />
                                </div>
                                <h4 class="font-bold text-brand-earth-dark text-lg mb-3">Rakt på sak</h4>
                                <p class="text-neutral-700 text-sm leading-relaxed">
                                    Efter förberedande övningar för att mjuka upp kroppen går vi direkt på formens rörelser.
                                </p>
                            </div>
                        </div>

                        <!-- Stage 2: Veckans Fokus -->
                        <div
                            class="bg-gradient-to-br from-brand-earth/5 to-brand-accent/5 rounded-xl p-6 border-2 border-brand-earth/20 shadow-sm">
                            <div class="flex flex-col items-center text-center h-full">
                                <div
                                    class="flex items-center justify-center h-16 w-16 rounded-full bg-brand-accent text-white mb-4 shadow-md">
                                    <Icon name="taichi_yinyang_gongbu" class="h-10 w-10" />
                                </div>
                                <h4 class="font-bold text-brand-earth-dark text-lg mb-3">Progression</h4>
                                <p class="text-neutral-700 text-sm leading-relaxed">
                                    Vi repeterar tidigare röresler och introducerar nya. Dessa knyts ihop till en enhetlig from som vi förlänger vecka för vecka.
                                </p>
                            </div>
                        </div>

                        <!-- Stage 3: Integration & Avslut -->
                        <div
                            class="bg-gradient-to-br from-brand-earth/5 to-brand-accent/5 rounded-xl p-6 border-2 border-brand-earth/20 shadow-sm">
                            <div class="flex flex-col items-center text-center h-full">
                                <div
                                    class="flex items-center justify-center h-16 w-16 rounded-full bg-brand-accent text-white mb-4 shadow-md">
                                    <Icon name="shield_health" class="h-8 w-8" />
                                </div>
                                <h4 class="font-bold text-brand-earth-dark text-lg mb-3">Långsiktig Hälsa</h4>
                                <p class="text-neutral-700 text-sm leading-relaxed">
                                    Du lär dig en metod för att förbättra din hälsa på sikt. Du lämnar kursen med en komplett sekvens, redo att användas när och var du vill.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Practical Info & Alternative -->
                <div class="space-y-6 pt-6 border-t border-neutral-200">

                    <div class="text-center">
                        <p class="text-neutral-700 italic">
                            Föredrar du ett mer intensivt eller anpassat upplägg?
                            <br class="hidden md:block">
                            Utforska våra <a href="/kurser/tai-chi/helgkurser/"
                                class="text-brand-sky font-semibold underline hover:text-brand-accent transition-colors">helgkurser</a> eller boka <a href="/kurser/tai-chi/privatundervisning/"
                                class="text-brand-sky font-semibold underline hover:text-brand-accent transition-colors">privatlektioner</a>.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- ======================================= -->
<!-- Sektion 4: Träningen & Gemenskapen      -->
<!-- ======================================= -->
<section class="section-standard bg-white overflow-hidden">
    <div class="container-base">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            
            <!-- Bild -->
            <div class="relative order-2 lg:order-1">
                <!-- Dekorativ ram/skugga -->
                <div class="absolute inset-0 bg-brand-accent transform -translate-x-3 translate-y-3 rounded-lg opacity-20"></div>
                <div class="relative rounded-lg overflow-hidden bg-brand-accent shadow-xl">
                    <Image src={taichiCircleImage}
                        alt="Elever som övar Tai Chi i en cirkel på grönt gräs"
                        class="w-full object-cover h-[480px] opacity-90 hover:scale-[1.02] transition-transform duration-500" />
                </div>
            </div>

            <!-- Text -->
            <div class="order-1 lg:order-2">
                <h2 class="text-brand-earth mb-6">Lär Dig Tai Chi, Steg för Steg</h2>
                <p class="mb-6">
                    Du behöver ingen tidigare erfarenhet eller vara i "god form" för att börja. Under ledning av våra
                    skickliga instruktörer guidas du tryggt genom varje moment, vecka för vecka.
                </p>
                <ul class="space-y-4 mb-8">
                    <li class="flex items-start">
                        <div class="flex-shrink-0 h-6 w-6 rounded-full bg-brand-accent/20 flex items-center justify-center text-brand-accent-dark mr-3 mt-1">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <div>
                            <strong class="text-brand-earth-dark block font-semibold text-lg">Du lär dig genom att göra</strong>
                            <span class="text-neutral-700">Vi börjar direkt med formen. Inlärningen sker genom praktisk
                                övning.</span>
                        </div>
                    </li>
                    <li class="flex items-start">
                        <div class="flex-shrink-0 h-6 w-6 rounded-full bg-brand-accent/20 flex items-center justify-center text-brand-accent-dark mr-3 mt-1">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <div>
                            <strong class="text-brand-earth-dark block font-semibold text-lg">En Tydlig Progression</strong>
                            <span class="text-neutral-700">Vi börjar från grunden och bygger metodiskt på med nya rörelser varje vecka.</span>
                        </div>
                    </li>
                    <li class="flex items-start">
                        <div class="flex-shrink-0 h-6 w-6 rounded-full bg-brand-accent/20 flex items-center justify-center text-brand-accent-dark mr-3 mt-1">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <div>
                            <strong class="text-brand-earth-dark block font-semibold text-lg">Grundande Gemenskap</strong>
                            <span class="text-neutral-700">Vi samskapar en harmonisk atmosfär med gemensam rörelse för fördjupad kroppskännedom och god hälsa.</span>
                        </div>
                    </li>
                </ul>

                <div class="bg-white/50 p-6 rounded-lg border-l-4 border-brand-earth mb-6">
                    <p class="italic text-neutral-800">
                        "Vi ser din hälsoresa som ett samspel. Vår roll är inte bara att instruera, utan att skapa en
                        trygg atmosfär där du kan använda Tai Chi som ditt personliga verktyg för hälsa och balans."
                    </p>
                </div>

                <!-- Team Link with Thumbnails -->
                <div class="flex items-center gap-4">
                    <div class="flex -space-x-3">
                        <Image class="inline-block h-10 w-10 rounded-full ring-2 ring-brand-earth bg-neutral-800"
                            src={johannes_mao_profileImage} alt="Johannes" />
                        <Image class="inline-block h-10 w-10 rounded-full ring-2 ring-brand-earth bg-neutral-800"
                            src={maria_morris_profileImage} alt="Maria" />
                        <Image class="inline-block h-10 w-10 rounded-full ring-2 ring-brand-earth bg-neutral-800"
                            src={magnus_rooth_profileImage} alt="Magnus" />
                    </div>
                    <a href="/om-oss/#team" class="btn-tertiary">
                        Möt våra instruktörer &rarr;
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ======================================= -->
<!-- Sektion 5: Aktuella Kursstarter (Logic) -->
<!-- ======================================= -->
<section class="section-standard bg-brand-earth-lightest/30" id="kursstarter">
    <div class="container-base">
        <h2 class="text-brand-earth text-center mb-10">Kommande Veckokurser i Tai Chi</h2>

        
        {activeCourses.length > 0 ? (
        <CourseScheduleTable courses={activeCourses} subject="taichi" defaultSub="veckokurs" />
        ) : (
        <div class="max-w-4xl mx-auto border-2 border-dashed border-neutral-300 rounded-xl p-8 md:p-12 bg-neutral-50">
            <h3 class="font-heading text-2xl text-brand-earth mb-4 text-center">Så här kommer du igång!</h3>
            <p class="text-neutral-700 mb-10 text-center max-w-2xl mx-auto">
                Just nu har vi inga schemalagda veckokurser, men det finns flera sätt att komma igång med Tai Chi redan nu.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-4 min-[890px]:gap-8">

                <!-- Väg 1: Intresseanmälan -->
                <div
                    class="bg-gradient-to-br from-brand-sky/5 to-brand-accent/5 p-8 md:p-4 min-[890px]:p-8 rounded-lg shadow-sm border-2 border-brand-sky/20 hover:-translate-y-1 transition-transform duration-300">
                    <div
                        class="flex items-center justify-center h-12 w-12 rounded-full bg-brand-sky text-white mb-4 shadow-md">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8 7V3m8 4V3M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                            </path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                d="M12 10.5l.9 1.8 2 .3-1.45 1.4.35 2-1.8-.95-1.8.95.35-2-1.45-1.4 2-.3.9-1.8z"
                                fill="currentColor"></path>
                        </svg>
                    </div>
                    <h4
                        class="font-bold text-brand-earth-dark text-xl md:text-base min-[890px]:text-xl mb-3 hyphens-auto">
                        Intresseanmälan för nästa termin</h4>
                    <p class="text-neutral-700 mb-6">
                        Var först med att få info om nästa planerade terminsstart. Genom att anmäla intresse hjälper du oss
                        planera.
                    </p>
                    <a href="/kontakt/?subject=taichi&sub=veckokurs#tidsbokning" class="btn-tertiary font-semibold">Anmäl intresse &rarr;</a>
                </div>

                <!-- Väg 2: Privatundervisning -->
                <div
                    class="bg-gradient-to-br from-brand-sky/5 to-brand-accent/5 p-8 md:p-4 min-[890px]:p-8 rounded-lg shadow-sm border-2 border-brand-sky/20 hover:-translate-y-1 transition-transform duration-300">
                    <div
                        class="flex items-center justify-center h-12 w-12 rounded-full bg-brand-sky text-white mb-4 shadow-md">
                        <!-- Magnifying Glass on Person Icon -->
                        <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                d="M21 21l-4.8-4.8m1.3-5.7a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            <circle cx="10.5" cy="8" r="1.8" stroke="currentColor" stroke-width="1.5" fill="none">
                            </circle>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                d="M7 13c0-1.933 1.567-3.5 3.5-3.5s3.5 1.567 3.5 3.5"></path>
                        </svg>
                    </div>
                    <h4
                        class="font-bold text-brand-earth-dark text-xl md:text-base min-[890px]:text-xl mb-3 hyphens-auto">
                        Privatundervisning</h4>
                    <p class="text-neutral-700 mb-6">
                        Få 100% odelad uppmärksamhet och undervisning anpassad för din vardag.
                    </p>
                    <a href="/kurser/tai-chi/privatundervisning/" class="btn-tertiary font-semibold">Läs mer &rarr;</a>
                </div>

                <!-- Väg 3: Egen Grupp -->
                <div
                    class="bg-gradient-to-br from-brand-sky/5 to-brand-accent/5 p-8 md:p-4 min-[890px]:p-8 rounded-lg shadow-sm border-2 border-brand-sky/20 hover:-translate-y-1 transition-transform duration-300">
                    <div
                        class="flex items-center justify-center h-12 w-12 rounded-full bg-brand-sky text-white mb-4 shadow-md">
                        <!-- Group of People Icon -->
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                            </path>
                        </svg>
                    </div>
                    <h4
                        class="font-bold text-brand-earth-dark text-xl md:text-base min-[890px]:text-xl mb-3 hyphens-auto">
                        Helgkurser</h4>
                    <p class="text-neutral-700 mb-6">
                        Lär dig grunderna snabbt över en helg. Perfekt för dig med svårt att hinna till veckopass.
                    </p>
                    <a href="/kurser/tai-chi/helgkurser/" class="btn-tertiary font-semibold">Läs mer
                        &rarr;</a>
                </div>

            </div>
        </div>
        )}
    </div>
</section>

<!-- ======================================= -->
<!-- Sektion 6: Anmälan & Info (CTA)   -->
<!-- ======================================= -->
<section id="anmalan" class="bg-brand-earth-light section-standard text-center">
    <div class="container-base max-w-4xl">

        <!-- Huvud CTA -->
        <div class="max-w-3xl mx-auto mb-16">
            <h2 class="text-brand-earth-dark mb-6 text-3xl md:text-5xl">Redo att börja din hälsoresa?</h2>
            <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-10">
                Nya terminsstarter planeras löpande. Om det inte finns några tillgängliga kursstarter som passar dig just nu, rekommenderar vi dig att anmäla ditt intresse för en plats på våra veckokurser. Då kontaktar vi dig personligen när vi lägger in nya starter och tider.
                <br /><span class="text-brand-earth-dark font-semibold">Din anmälan är helt kostnadsfri och inte
                    bindande.</span>
            </p>

            <a href="/kontakt/?subject=taichi&sub=veckokurs#tidsbokning"
                class="btn btn-primary-on-dark shadow-lg shadow-black/10 px-10 py-5 text-xl mb-8">
                Anmäl intresse & få mer information
            </a>

            <p class="text-brand-earth-dark mb-0 italic">
                {/* {%set tel = get_contact_detail('tel')%} */}
                Har du frågor om upplägget? Ring oss gärna på <a href={`tel:${siteConfig.phones.johannes.clean}`}
                    class="text-brand-sky underline hover:text-brand-sky-dark">{siteConfig.phones.johannes.display}</a>.
            </p>
        </div>

        <!-- Trust & Info Row (Discrete boxes with icon containers) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 pt-6 mt-0 border-t border-brand-earth-dark/10">

            <!-- Column 1: Platser -->
            <div
                class="group bg-brand-earth-dark/5 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border-2 border-brand-earth-dark/10 flex flex-col items-start text-left">
                <div class="flex items-center mb-4">
                    <div
                        class="flex items-center justify-center h-10 w-10 rounded-full bg-brand-earth-dark/25 mr-3">
                        <div class="relative flex h-3 w-3 items-center justify-center">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-accent"></span>
                        </div>
                    </div>
                    <span class="font-bold text-brand-earth-dark text-xl">Platser</span>
                </div>
                <div class="text-neutral-700 leading-relaxed text-sm md:text-base flex-grow">
                    Våra kurser hålls i <a href="/kontakt/#mottagningar"
                        class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Nyköping</a>, <a href="/kontakt/#mottagningar"
                        class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Gnesta</a> och <a href="/kontakt/#mottagningar"
                        class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Oxelösund</a>.
                </div>
                <a href="/kontakt/#mottagningar"
                    class="text-brand-sky hover:text-brand-sky-dark font-medium flex items-center mt-4 group-hover:translate-x-1 transition-transform">Se
                    alla adresser &rarr;</a>
            </div>

            <!-- Column 2: Friskvård -->
            <div
                class="group bg-brand-earth-dark/5 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border-2 border-brand-earth-dark/10 flex flex-col items-start text-left">
                <div class="flex items-center mb-4">
                    <div
