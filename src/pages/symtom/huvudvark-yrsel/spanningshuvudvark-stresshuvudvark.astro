---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/hero_huvudvark2.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';
import tuinaImage from '../../../assets/images/tuina_head_woman.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'Eftersom spänningshuvudvärk oftast har sin grund i muskulaturen är TuiNa-massage en mycket effektiv behandling. Vi arbetar djupt med att lösa upp knutar och strama muskler i nacke, axlar, bröstrygg och käkar. Genom att minska det mekaniska draget från musklerna upp mot huvudet, lindrar vi effektivt smärtan.',
        image: tuinaImage,
        alt: 'TuiNa-massage för att lösa upp spänningar i nacke och axlar',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur är fantastiskt för att varva ner nervsystemet och hantera den bakomliggande stressen som ofta triggar spänningshuvudvärk. Genom att öka blodcirkulationen och stimulera kroppens frisättning av smärtlindrande endorfiner hjälper vi musklerna att slappna av på djupet och förebygger framtida besvär.',
        image: acupunctureImage,
        alt: 'Akupunktur för att behandla stress och spänningshuvudvärk',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    }
];

const faqs = [
    {
        question: 'Hur många behandlingar behövs för spänningshuvudvärk?',
        answer: 'Många känner en tydlig lättnad inom 3 behandlingar. För mer långvariga eller stressrelaterade besvär rekommenderar vi en lite längre behandlingsserie, där vi utöver de fysiska spänningarna även arbetar mer djupgående med nervsystemets återhämtning.'
    },
    {
        question: 'Kan stress och ett stillasittande jobb leda till spänningshuvudvärk?',
        answer: 'Absolut. En statisk arbetsställning framför en skärm, särskilt i kombination med mental stress och ytlig andning, är den vanligaste orsaken till att musklerna i nacke, bröst och axlar blir kroniskt spända och utlöser huvudvärken.'
    },
    {
        question: 'Gör massagen ont när musklerna är så stela?',
        answer: 'TuiNa är en kraftfull och djupgående massage. Det kan kännas ordentligt när vi arbetar med stela muskler, en typ av "skön-ont" känsla. Vi anpassar dock alltid trycket efter din kropps förutsättningar och ser till att behandlingen känns befriande, inte plågsam.'
    }
];
---

<BaseLayout 
    title="Behandling av Spänningshuvudvärk & Stresshuvudvärk | Medidraken"
    description="Få hjälp med din spänningshuvudvärk. Vi arbetar med akupunktur & TuiNa-massage för att lösa upp spänningar i nacke och käkar samt reducera stress."
>
    
    <SymptomHero
        title="Låt Oss Hjälpa Dig Med Din Spänningshuvudvärk"
        subtitle="Effektiv Behandling för Nacke, Axlar och Huvud"
        image={heroImage}
        imageAlt="Behandling av spänningshuvudvärk och stresshuvudvärk"
        buttonText="Boka Behandling"
        buttonLink="/kontakt"
    >
        Upplever du en molande värk som ett trångt band runt huvudet? 
        </br>
        Spänningshuvudvärk och stresshuvudvärk kommer ofta från ihållande muskelspänningar i nacke, axlar och käkar, inte sällan i kombination med stress och statiskt arbete. 
        Vi hjälper dig att lösa upp spänningarna från grunden, lugna nervsystemet och ge dig verktyg för en smidigare och smärtfri vardag.
    </SymptomHero>

    <SymptomMethods
        title="Hur vi Behandlar Spänningshuvudvärk"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            För att komma till rätta med spänningshuvudvärk behöver vi både behandla de fysiska muskelknutarna och adressera den stress som ofta ligger till grund för dem.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Genom att kombinera djupgående kroppsterapi med nervsystemsreglering ger vi din kropp de bästa förutsättningarna för att släppa taget om smärtan och förhindra att den kommer tillbaka. Metoderna kan användas var för sig eller i kombination.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            Hör av dig så hittar vi det behandlingsupplägg som fungerar bäst för dina behov.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Få Hjälp Med Din Huvudvärk"
        ctaButtonText="Hör av Dig & Boka behandling"
        ctaSubject="spanningshuvudvark"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Att gå med ständig huvudvärk dränerar kroppen på energi. Låt oss hjälpa dig att släppa spänningarna. Många upplever en förbättring inom de första 3 behandlingarna.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Spänningshuvudvärk"
        faqs={faqs}
    />

</BaseLayout>
