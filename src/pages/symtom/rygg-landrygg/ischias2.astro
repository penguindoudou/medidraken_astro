---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/hero_ryggont8.png';
import tuinaManImage from '../../../assets/images/tuina_man.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'TuiNa-massage är mycket effektivt för att manuellt lösa upp de djupt liggande muskelspänningar i säte och ländrygg som ofta är den fysiska orsaken till trycket på nerven (s.k. falsk ischias).',
        image: tuinaManImage,
        alt: 'TuiNa-massage för att lösa djupliggande muskelspänningar vid ischias',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur är ett kraftfullt verktyg för att stimulera kroppens energisystem, minska inflammation, hjälpa nerven att slappna av och lindra den utstrålande smärtan.',
        image: acupunctureImage,
        alt: 'Akupunktur för smärtlindring vid ischias och utstrålande smärta',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    }
];

const faqs = [
    {
        question: 'Vad är skillnaden mellan "äkta" och "falsk" ischias?',
        answer: '"Äkta" ischias orsakas oftast av ett tryck på nervroten i ryggraden (t.ex. från ett diskbråck). "Falsk" ischias (eller piriformissyndrom) orsakas av att en spänd muskel i sätet trycker på nerven. Våra metoder är anpassade för att hantera båda tillstånden, antingen genom att lindra inflammation eller lösa upp djupliggande muskelspänningar.'
    },
    {
        question: 'Kan behandlingen göra det värre i början?',
        answer: 'Efter en djupgående behandling kan du uppleva en tillfällig träningsvärk eller ömhet i musklerna, vilket är normalt. Själva nervsmärtan brukar dock inte förvärras. Vi för alltid en noggrann dialog med dig för att säkerställa att behandlingen är trygg och anpassad efter din reaktion.'
    },
    {
        question: 'Vad kan jag göra själv för att förebygga att det händer igen?',
        answer: 'Ett hållbart resultat bygger på samarbete. När vi har minskat det akuta trycket och smärtan rekommenderar vi att du stärker muskulaturen och förbättrar din hållning. Regelbunden praktik av Tai Chi och Qigong är utmärkta verktyg för att bygga en stark, balanserad och stabil grund på lång sikt.'
    }
];
---

<BaseLayout title="Behandling av Ischias & Smärta i Benet i Nyköping | Medidraken">
    
    <SymptomHero
        title="Ischias & Utstrålande Smärta"
        subtitle="Lindra Smärtan & Återfå Din Rörlighet"
        image={heroImage}
        imageAlt="Ischias Behandling"
        buttonText="Behandla ischias"
        buttonLink="/kontakt"
    >
        Den karaktäristiska smärtan från ischias – som ilar från ländryggen, genom sätet och ner i benet – kan vara både intensiv och begränsande.
        
        Genom kinesisk medicinsk behandling fokuserar vi på att lösa upp spänningar, minska trycket på ischiasnerven och lindra både smärta och eventuella domningar, så att du kan återfå din normala rörlighet.
    </SymptomHero>

    <SymptomMethods
        title="Hur vi Behandlar Ischias & Utstrålande Smärta"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Ischiassmärta orsakas ofta av ett tryck eller en inflammation runt nerven i ländrygg eller säte.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-6">
            Vi erbjuder två kompletterande tillvägagångssätt för att adressera både symtomet och den bakomliggande orsaken. De kan användas var för sig eller i kombination.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            Hör av dig så hittar vi tillsammans det upplägg som passar dig bäst.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Ta Kontroll över Smärtan och Återfå Din Rörlighet"
        ctaButtonText="Hör av dig för en konsultation"
        ctaSubject="ischias"
    >
        <p>
            Vi hjälper dig hitta rätt behandling för din ischiassmärta. Vår erfarenhet visar att många upplever en märkbar skillnad i smärta och rörlighet inom 3 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Behandling av Ischias"
        faqs={faqs}
    />

</BaseLayout>
