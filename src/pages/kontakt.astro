---
export const prerender = false;

import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

// Images
import johannesImage from '../assets/images/johannes_mao_profile.jpg';
import linneaImage from '../assets/images/linnea_mao_profile.jpg';
import heroImage from '../assets/images/Tai-Chi kurs 2.jpg';
import { siteConfig } from '../data/site.ts';
import { coursesTaiChi, coursesQigong } from '../data/courses.ts';

// Helpers for prefilling next upcoming helgkurs
const today = new Date().setHours(0, 0, 0, 0);
const nextTaiChi = coursesTaiChi.find(c => new Date(c.lastDate).getTime() >= today);
const nextQigong = coursesQigong.find(c => new Date(c.lastDate).getTime() >= today);

const symptomsMap: Record<string, string> = {
  // Categories
  'rygg-landrygg': 'Rygg & Ländrygg',
  'nacke-axlar-skuldror': 'Nacke, Axlar & Skuldror',
  'huvudvark': 'Huvudvärk & Balansproblem',
  'ledvark-idrottsskador': 'Ledvärk, Ledbesvär & Idrottsskador',
  'somnproblem': 'Sömnbesvär',
  'utbrandhet-trotthet': 'Utbrändhet & Trötthet',
  'ofta-forkyld': 'Ofta Förkyld',
  
  // Specific
  'akut-ryggont': 'Rygg: Akut Ryggskott',
  'ischias': 'Rygg: Ischiasbesvär & Smärta som strålar i benet',
  'langvarig-vark-stelhet-landrygg': 'Rygg: Långvarig värk & Stelhet i ländryggen',
  'nacksparr-stel-nacke': 'Nacke/Axlar: Nackspärr & Stel nacke',
  'ont-i-axlar-skuldror': 'Nacke/Axlar: Ont i Axlar & Skuldror',
  'spanningshuvudvark-stresshuvudvark': 'Huvudvärk: Spänningshuvudvärk & Stresshuvudvärk',
  'migran': 'Huvudvärk: Migrän',
  'balansproblem': 'Huvudvärk: Balansproblem',
  'ont-i-knan-knabesvar': 'Ledvärk: Ont i knän & knäbesvär',
  'ont-i-hofter-hoftbesvar': 'Ledvärk: Ont i höfter & höftbesvär',
  'tennisarmbage-musarm': 'Ledvärk: Tennisarmbåge, Musarm & Värk i handleder'
};

const healthGoalsMap: Record<string, string> = {
  'minska-stress-hitta-inre-lugn': 'Minska Stress & Hitta Inre Lugn',
  'oka-energi-livskraft': 'Öka Energi & Livskraft i Vardagen',
  'forbattra-balans-rorlighet-kroppskontroll': 'Förbättra Balans, Rörlighet & Kroppskontroll',
  'stark-fokus-mental-styrka': 'Stärka Fokus & Mental Styrka',
  'starka-motstandskraften': 'Stärk Motståndskraften'
};

const subjectMap: Record<string, string> = {
  'taichi': 'Tai Chi',
  'qigong': 'Medicinsk Qigong',
  'instruktorskurs': 'Instruktörskurs',
  'behandling': 'Behandling',
  'halsoresa': 'Hälsoresa till Kina',
  'workshop': 'Workshops & Gruppaktiviteter',
  'halsodag': 'Skräddarsydda Hälsodagar',
  'presentkort': 'Presentkort',
  'ovrigt': 'Övrigt'
};

let formStatus = '';

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    
    if (data.get("website")) {
      formStatus = 'success';
      throw new Error("SILENT_HONEYPOT");
    }

    // Get env vars with fallback for Cloudflare runtime
    let botToken = import.meta.env.TELEGRAM_BOT_TOKEN || process.env.TELEGRAM_BOT_TOKEN || (Astro.locals as any).runtime?.env?.TELEGRAM_BOT_TOKEN;
    const chatId = import.meta.env.TELEGRAM_CHAT_ID || process.env.TELEGRAM_CHAT_ID || (Astro.locals as any).runtime?.env?.TELEGRAM_CHAT_ID;
    
    // Clean token (remove 'bot' prefix if user accidentally included it, remove quotes/spaces)
    if (botToken) {
      botToken = botToken.trim().replace(/^['"]|['"]$/g, '').replace(/^bot/i, '');
    }
    
    let text = `📨 Nytt kontaktformulär!\n`;
    text += `Namn: ${data.get("name") || "-"}\n`;
    text += `E-post: ${data.get("email") || "-"}\n`;
    text += `Telefon: ${data.get("phone") || "-"}\n`;

    const interestSymptom = data.get("interest_symptom");
    const interestHealthGoal = data.get("interest_health_goal");
    const interestService = data.get("interest_service");

    const interests: string[] = [];
    if (interestSymptom) interests.push("Symptom & Besvär");
    if (interestHealthGoal) interests.push("Hälsomål");
    if (interestService) interests.push("Specifik Tjänst");
    text += `Intresseområden: ${interests.join(", ") || "-"}\n`;

    // Symptoms
    const rawSymptoms = data.getAll("symptoms");
    if (rawSymptoms.length > 0) {
      const symptomNames = rawSymptoms.map(key => symptomsMap[key] || key);
      text += `Symptom/Besvär: ${symptomNames.join(', ')}\n`;
    }

    // Health Goals
    const rawGoals = data.getAll("health_goals");
    if (rawGoals.length > 0) {
      const goalNames = rawGoals.map(key => healthGoalsMap[key] || key);
      text += `Hälsomål: ${goalNames.join(', ')}\n`;
    }

    // Specific Service
    const rawSubjects = data.getAll("subject");
    if (rawSubjects.length > 0) {
      const subjectNames = rawSubjects.map(key => subjectMap[key as string] || key);
      text += `Ärende/Tjänst: ${subjectNames.join(', ')}\n`;
    }
    
    const location = data.get("location");
    if (location) text += `Ort: ${location}\n`;
    
    const useFriskvardsbidrag = data.get("use_friskvardsbidrag");
    if (useFriskvardsbidrag) {
        text += `Vill använda friskvårdsbidrag: Ja\n`;
        const friskvardsAmount = data.get("friskvards_amount");
        if (friskvardsAmount) text += `Friskvårdsbelopp: ${friskvardsAmount} kr\n`;
    }
    
    const courseType = data.get("course_type");
    if (courseType) text += `Kurs/Behandling typ: ${courseType}\n`;

    const behandlingType = data.get("behandling_type");
    if (behandlingType) text += `Behandling typ: ${behandlingType}\n`;
    
    const specificRequest = data.get("specific_request");
    if (specificRequest) text += `Specifik förfrågan: ${specificRequest}\n`;
    
    const giftcardType = data.get("giftcard_type");
    if (giftcardType) {
        text += `Presentkort typ: ${giftcardType}\n`;
        const amount = data.get("amount");
        if (amount) text += `Belopp: ${amount} kr\n`;
        const recipient = data.get("recipient_name");
        if (recipient) text += `Mottagare: ${recipient}\n`;
    }
    
    const otherRequest = data.get("other_request");
    if (otherRequest) text += `Övrigt: ${otherRequest}\n`;
    
    const specificDate = data.get("specific_date");
    if (specificDate) text += `Specifikt Datum: ${specificDate}\n`;
    
    const specificTime = data.get("specific_time");
    if (specificTime) text += `Specifik Tid: ${specificTime}\n`;
    
    const preferredDays = data.get("preferred_days");
    if (preferredDays) text += `Föredragna dagar: ${preferredDays}\n`;
    
    const preferredTimeRanges = data.get("preferred_time_ranges");
    if (preferredTimeRanges) text += `Föredragen tid på dygnet: ${preferredTimeRanges}\n`;
    
    const preferredTravelPeriods = data.get("preferred_travel_periods");
    if (preferredTravelPeriods) text += `Hälsoresa period: ${preferredTravelPeriods}\n`;
    
    const customTravelPeriod = data.get("custom_travel_period");
    if (customTravelPeriod) text += `Hälsoresa datum: ${customTravelPeriod}\n`;

    const message = data.get("message");
    if (message) text += `\nMeddelande:\n${message}`;

    // Telegram limit is 4096. Truncate total payload to 4000 chars.
    if (text.length > 4000) {
      text = text.substring(0, 4000) + '... [Klippt]';
    }

    if (botToken && chatId) {
       const response = await fetch(`https://api.telegram.org/bot${botToken}/sendMessage`, {
         method: 'POST',
         headers: { 'Content-Type': 'application/json' },
         body: JSON.stringify({ chat_id: chatId, text: text })
       });
       if (response.ok) {
         formStatus = 'success';
       } else {
         formStatus = 'error';
         console.error("Telegram API Error:", await response.text());
       }
    } else {
      console.error("Missing telegram credentials");
      formStatus = 'error';
    }
  } catch (e) {
    if (e instanceof Error && e.message === "SILENT_HONEYPOT") {
      // Do nothing, silent fail
    } else {
      console.error("Form processing error:", e);
      formStatus = 'error';
    }
  }
}
---

<BaseLayout title="Kontakt"
  description="Kontakta Medidraken för bokning och frågor. Vi finns i Nyköping, Gnesta och Oxelösund. Varmt välkommen till våra mottagningar.">
    <!-- Sektion 1: Hero – Kontakta Oss -->
    <section class="hero-section">
        <div class="hero-background">
            <Image src={heroImage} alt="Tai Chi kurs för harmoni och hälsa" class="hero-bg-image opacity-70" />
        </div>
        <div class="hero-content text-center">
            <div class="hero-text bg-brand-earth-dark/80 p-4 md:p-6 rounded-lg backdrop-blur-sm border border-white/10 md:max-w-5xl mx-auto">
                <h1 class="hero-title text-brand-accent">Kontakta Oss</h1>

                <div class="text-lg text-neutral-100 leading-relaxed mt-0">
                    <h2 class="hero-subtitle font-semibold">Vi ser fram emot att höra från dig!</h2>

                    <p class="hero-text mt-2">
                        Oavsett om du har en fråga, vill anmäla ditt intresse för en kurs eller boka en behandling,
                        är du varmt välkommen att höra av dig.
                    </p>

                    <p class="hero-text mt-2 md:mt-5">
                        För snabbast svar rekommenderar vi att du ringer <a href={`tel:${siteConfig.phone.clean}`}
                            class="text-brand-accent-light hover:text-brand-sky-bright font-normal underline decoration-brand-accent-light/30 underline-offset-4 transition-colors duration-200">{siteConfig.phone.display}</a>
                        eller använder formuläret
                        nedan.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Huvudinnehåll: Tidsbokning & Formulär (Ljus Jord-bakgrund) -->
    <section class="pb-20 lg:pb-28 bg-brand-earth-lightest relative overflow-hidden">
        <div class="container-base space-y-6 lg:space-y-12">

            <!-- Rad 2: Tillgänglighet och Tidsbokning (Flyttad upp) -->
            <div id="tidsbokning"
                class="scroll-mt-20 text-center max-w-5xl mx-auto py-8 lg:py-10 border-y border-brand-earth-light/20">
                <h2 class="text-3xl text-brand-earth-dark font-semibold mb-10">Tillgänglighet och Tidsbokning</h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Tidsbokning -->
                    <div
                        class="flex flex-col items-center p-6 bg-white rounded-xl shadow-sm border border-brand-earth-light/20">
                        <div
                            class="w-16 h-16 bg-brand-accent/10 rounded-full flex items-center justify-center mb-4 text-brand-accent-dark">
                            <Icon name="calendar" class="w-10 h-10" />
                        </div>
                        <h4 class="text-xl font-bold text-brand-earth-dark mb-3">Endast tidsbokning</h4>
                        <p class="text-neutral-700 leading-relaxed">
                            Alla behandlingar, kurser och privatlektioner hos Medidraken sker endast efter
                            tidsbokning.
                        </p>
                    </div>

                    <!-- Vanliga tider -->
                    <div
                        class="flex flex-col items-center p-6 bg-white rounded-xl shadow-sm border border-brand-earth-light/20">
                        <div
                            class="w-16 h-16 bg-brand-accent/10 rounded-full flex items-center justify-center mb-4 text-brand-accent-dark">
                            <Icon name="clock" class="w-10 h-10" />
                        </div>
                        <h4 class="text-xl font-bold text-brand-earth-dark mb-3">Vanliga tider</h4>
                        <p class="text-neutral-700 leading-relaxed">
                            Vi erbjuder vanligtvis tider alla dagar i veckan mellan kl. 09:00 och 20:00, men vi är
                            flexibla och kan ofta anpassa oss efter ditt schema.
                        </p>
                    </div>

                    <!-- Kontakta oss -->
                    <div
                        class="flex flex-col items-center p-6 bg-white rounded-xl shadow-sm border border-brand-earth-light/20">
                        <div
                            class="w-16 h-16 bg-brand-accent/10 rounded-full flex items-center justify-center mb-4 text-brand-accent-dark">
                            <Icon name="phone_outline" class="w-10 h-10" />
                        </div>
                        <h4 class="text-xl font-bold text-brand-earth-dark mb-3">Hitta en tid</h4>
                        <p class="text-neutral-700 leading-relaxed">
                            Kontakta oss så hjälper vi dig att hitta en tid som passar dig.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Rad 3: Formulär & Kontaktinfo -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
                <!-- Vänster: Formulär -->
                <div
                    class="contact-form-wrapper bg-white shadow-xl shadow-brand-earth/5 p-8 sm:p-10 rounded-2xl border border-brand-earth-light/30">
                    <h3 class="text-2xl text-brand-earth mb-6 font-semibold">Skicka ett Meddelande</h3>

                    {formStatus === 'success' ? (
                        <div class="bg-brand-sky-light/10 border border-brand-sky/30 rounded-xl p-8 text-center">
                            <div class="w-16 h-16 bg-brand-sky/20 rounded-full flex items-center justify-center mx-auto mb-4 text-brand-sky-dark">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h4 class="text-2xl font-bold text-brand-earth-dark mb-2">Tack för ditt meddelande!</h4>
                            <p class="text-neutral-700">Vi har tagit emot din förfrågan och återkommer så snart vi kan.</p>
                            <a href="/kontakt" class="mt-6 inline-block btn btn-primary-on-light">Skicka ett till meddelande</a>
                        </div>
                    ) : (
                        <>
                            {formStatus === 'error' && (
                                <div class="bg-red-50 text-red-600 p-4 rounded-lg mb-6 border border-red-200">
                                    Något gick fel när meddelandet skulle skickas. Vänligen försök igen eller kontakta oss via telefon eller e-post.
                                </div>
                            )}
                            <!-- NOTERA TILL UTVECKLARE: Här kan du klistra in din Fluent Forms shortcode typ [fluentform id="1"].
                            Nedan är en välbyggd mockup på hur formuläret ska se ut enligt instruktionerna. -->
                            <form action="" method="POST" class="space-y-5"
                                @submit="if (!validateForm()) $event.preventDefault()"
                                x-data="{ 
                                    hasSymptom: false,
                                    hasHealthGoal: false,
                                    hasService: false,
                                    symptomCats: [],
                                    symptoms: [],
                                    healthGoals: [],
                                    validationError: '',
                                    subjects: [], 
                                    subSubject: '', 
                                    location: '', 
                                    recipient: 'Okänd', 
                                    amount: '',
                                    useFriskvardsbidrag: false,
                                    friskvardsAmount: '',
                                    selectedDays: [],
                                    selectedTimes: [],
                                    selectedTravelPeriods: [],
                                    customTravelPeriod: '',
                                    specificDate: '',
                                    specificTime: '',
                                    useSpecificDate: false,
                                    isPrefilled: false,
                                    prefillSource: '',
                                    getSymptomParent(symptom) {
                                        const parentMap = {
                                            'akut-ryggont': 'rygg-landrygg',
                                            'ischias': 'rygg-landrygg',
                                            'langvarig-vark-stelhet-landrygg': 'rygg-landrygg',
                                            'nacksparr-stel-nacke': 'nacke-axlar-skuldror',
                                            'ont-i-axlar-skuldror': 'nacke-axlar-skuldror',
                                            'spanningshuvudvark-stresshuvudvark': 'huvudvark',
                                            'migran': 'huvudvark',
                                            'balansproblem': 'huvudvark',
                                            'ont-i-knan-knabesvar': 'ledvark-idrottsskador',
                                            'ont-i-hofter-hoftbesvar': 'ledvark-idrottsskador',
                                            'tennisarmbage-musarm': 'ledvark-idrottsskador'
                                        };
                                        return parentMap[symptom] || null;
                                    },
                                    toggleSymptomCat(cat) {
                                        if (this.symptomCats.includes(cat)) {
                                            this.symptomCats = this.symptomCats.filter(c => c !== cat);
                                            this.symptoms = this.symptoms.filter(s => this.getSymptomParent(s) !== cat);
                                        } else {
                                            this.symptomCats.push(cat);
                                        }
                                    },
                                    isMessageRequired() {
                                        return this.hasSymptom || this.hasHealthGoal || (this.hasService && !this.subjects.includes('ovrigt'));
                                    },
                                    validateForm() {
                                        this.validationError = '';
                                        if (!this.hasSymptom && !this.hasHealthGoal && !this.hasService) {
                                            this.validationError = `Välj minst ett av de tre alternativen.`;
                                            return false;
                                        }
                                        if (this.hasSymptom && this.symptomCats.length === 0) {
                                            this.validationError = 'Vänligen välj minst ett symptom/besvär i listan.';
                                            return false;
                                        }
                                        if (this.hasHealthGoal && this.healthGoals.length === 0) {
                                            this.validationError = 'Vänligen välj minst ett hälsomål i listan.';
                                            return false;
                                        }
                                        if (this.hasService && this.subjects.length === 0) {
                                            this.validationError = 'Vänligen välj minst en specifik tjänst / ett ärende.';
                                            return false;
                                        }
                                        return true;
                                    },
                                    init() {
                                        const symptomsList = [
                                            'rygg-landrygg', 'nacke-axlar-skuldror', 'huvudvark', 'ledvark-idrottsskador',
                                            'akut-ryggont', 'ischias', 'langvarig-vark-stelhet-landrygg', 'nacksparr-stel-nacke', 
                                            'ont-i-axlar-skuldror', 'spanningshuvudvark-stresshuvudvark', 'migran', 'balansproblem', 
                                            'ont-i-knan-knabesvar', 'ont-i-hofter-hoftbesvar', 'tennisarmbage-musarm', 'somnproblem', 
                                            'utbrandhet-trotthet', 'ofta-forkyld'
                                        ];
                                        const healthGoalsList = [
                                            'minska-stress-hitta-inre-lugn', 'oka-energi-livskraft', 'forbattra-balans-rorlighet-kroppskontroll', 
                                            'stark-fokus-mental-styrka', 'starka-motstandskraften'
                                        ];

                                        const params = new URLSearchParams(window.location.search);
                                        if (params.has('subject')) {
                                            const urlSubj = params.get('subject');
                                            if (urlSubj === 'friskvardsbidrag') {
                                                this.useFriskvardsbidrag = true;
                                                this.hasService = true;
                                                this.subjects = [];
                                            } else if (symptomsList.includes(urlSubj)) {
                                                this.hasSymptom = true;
                                                const parent = this.getSymptomParent(urlSubj);
                                                if (parent) {
                                                    if (!this.symptomCats.includes(parent)) this.symptomCats.push(parent);
                                                    if (!this.symptoms.includes(urlSubj)) this.symptoms.push(urlSubj);
                                                } else {
                                                    if (!this.symptomCats.includes(urlSubj)) this.symptomCats.push(urlSubj);
                                                }
                                            } else if (healthGoalsList.includes(urlSubj)) {
                                                this.hasHealthGoal = true;
                                                if (!this.healthGoals.includes(urlSubj)) this.healthGoals.push(urlSubj);
                                            } else {
                                                this.hasService = true;
                                                this.subjects = [urlSubj];
                                            }
                                        }
                                        if (params.has('sub')) this.subSubject = params.get('sub');
                                        if (params.has('location')) this.location = params.get('location');
                                        let urlDate = params.has('date') ? params.get('date') : null;
                                        let urlTime = params.has('time') ? params.get('time') : null;

                                        this.$watch('hasService', value => {
                                            if (!value) {
                                                this.subjects = [];
                                                this.subSubject = '';
                                            }
                                        });
                                        this.$watch('hasSymptom', value => {
                                            if (!value) {
                                                this.symptomCats = [];
                                                this.symptoms = [];
                                            }
                                        });
                                        this.$watch('hasHealthGoal', value => {
                                            if (!value) {
                                                this.healthGoals = [];
                                            }
                                        });

                                        this.$watch('useFriskvardsbidrag', value => {
                                            if (value && this.subjects.includes('presentkort')) {
                                                this.subjects = this.subjects.filter(s => s !== 'presentkort');
                                            }
                                        });
                                        
                                        this.$watch('subjects', value => { 
                                            if (params.has('subject') && params.get('subject') !== 'friskvardsbidrag' && !value.includes(params.get('subject'))) {
                                                urlDate = null;
                                                urlTime = null;
                                            }
                                            // Optional: Reset subSubject if primary subjects change dramatically, 
                                            // but allowing it to stay is fine for multiple selection.
                                            // this.subSubject = '';
                                            this.selectedDays = [];
                                            this.selectedTimes = [];
                                            this.selectedTravelPeriods = [];
                                            this.customTravelPeriod = '';
                                            this.specificDate = urlDate || '';
                                            this.specificTime = urlTime || '';
                                            this.isPrefilled = false;
                                        });

                                        const applyPrefill = () => {
                                            if (this.subSubject === 'helgkurs') {
                                                if (urlDate || urlTime) {
                                                    this.specificDate = urlDate || '';
                                                    this.specificTime = urlTime || '';
                                                    this.isPrefilled = true;
                                                    this.prefillSource = 'url';
                                                    this.useSpecificDate = true;
                                                } else {
                                                    let course = null;
                                                    try {
                                                        const elId = this.subjects.includes('taichi') ? 'nextTaiChiData' : (this.subjects.includes('qigong') ? 'nextQigongData' : null);
                                                        if (elId) {
                                                            const el = document.getElementById(elId);
                                                            if (el && el.textContent) course = JSON.parse(el.textContent);
                                                        }
                                                    } catch (e) {
                                                        console.warn('Could not parse course data', e);
                                                    }
                                                    
                                                    if (course) {
                                                        this.specificDate = course.date || '';
                                                        this.specificTime = course.times || '';
                                                        this.isPrefilled = true;
                                                        this.prefillSource = 'auto';
                                                        this.useSpecificDate = true;
                                                    } else {
                                                        this.specificDate = '';
                                                        this.specificTime = '';
                                                        this.isPrefilled = false;
                                                        this.prefillSource = '';
                                                    }
                                                }
                                            } else {
                                                this.isPrefilled = false;
                                                this.prefillSource = '';
                                                this.useSpecificDate = false;
                                            }
                                        };

                                        this.$watch('subSubject', value => {
                                            if (params.has('sub') && value !== '' && value !== params.get('sub')) {
                                                urlDate = null;
                                                urlTime = null;
                                            }
                                            applyPrefill();
                                        });

                                        this.$watch('selectedTravelPeriods', (value, oldValue) => {
                                            const unsure = 'Vet ej / Behöver rådgivning';
                                            if (value.includes(unsure) && value.length > 1) {
                                                if (oldValue.includes(unsure)) {
                                                    this.selectedTravelPeriods = value.filter(p => p !== unsure);
                                                } else {
                                                    this.selectedTravelPeriods = [unsure];
                                                }
                                            }
                                        });

                                        if (this.subSubject === 'helgkurs') {
                                            setTimeout(applyPrefill, 100);
                                        } else if (urlDate || urlTime) {
                                            this.specificDate = urlDate || '';
                                            this.specificTime = urlTime || '';
                                            this.useSpecificDate = true;
