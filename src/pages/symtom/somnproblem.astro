---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SymptomHero from '../../components/symptom/SymptomHero.astro';
import SymptomMethodsThreeCol from '../../components/symptom/SymptomMethodsThreeCol.astro';
import SymptomCTA from '../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../assets/images/hero_somnproblem2.png';
import acupunctureImage from '../../assets/images/aku_doll6.png';
import tuinaManImage from '../../assets/images/tuina_girl_wide2.png';
import taichiImage from '../../assets/images/taichi_in_a_circle_instructor_johannes_teaching_several_white_crane_spreading_its_wings_grass_sunny_weather.jpg';

const methods = [
    {
        title: 'Medicinsk Kinesisk Massage (TuiNa)',
        desc: 'Medicinsk Kinesisk Massage hjälper till att lösa upp fysiska spänningar och stress i kroppen, vilket hjälper sinnet att varva ner så att du kan sova gott och känna dig mer utvilad.',
        image: tuinaManImage,
        alt: 'Medicinsk Kinesisk Massage (TuiNa) för djup avslappning och bättre sömn',
        url: '/behandling/medicinsk-kinesisk-massage/',
        linkText: '→ Läs mer om Medicinsk Kinesisk Massage (TuiNa)',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur hjälper kroppen att minska stress, balansera nerv- och energisystem, så att du får förutsättningar att sova gott och känna dig mer utvilad.',
        image: acupunctureImage,
        alt: 'Akupunktur lugnar nervsystemet och hjälper vid sömnproblem',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    },
    {
        title: 'Tai Chi & Qigong',
        desc: 'Skonsamma och meditativa rörelser som hjälper dig att sänka stressnivåerna, minska oro och bygga upp kroppens energi på ett harmoniskt sätt.',
        image: taichiImage,
        alt: 'Lugnande rörelser och andning med Tai Chi och Qigong',
        url: '/kurser',
        linkText: '→ Läs mer om vår träning',
        theme: 'accent' as const
    }
];

const faqs = [
    {
        question: 'Kan Medicinsk Kinesisk Massage (Tuina) och Akupunktur hjälpa vid sömnproblem?',
        answer: 'Ja, Medicinsk Kinesisk Massage (Tuina) och Akupunktur är mycket effektivt för att lugna nervsystemet och minska stress. Många patienter upplever en djup avslappning redan under behandlingen och sover ofta bättre efter en behandlingsperiod.'
    },
    {
        question: 'Hjälper Tai Chi och Qigong mot sömnproblem?',
        answer: 'Ja, det är ett kraftfullt verktyg. Träningen balanserar kroppen genom långsamma medvetna rörelser och medveten andning. Det sänker kroppens kortisolnivåer och lugnar nervsystemet. För dig med sömnbesvär innebär det att du tränar upp förmågan att stilla tankarna och skifta från dagens stress till nattens vila, vilket underlättar både insomning och djupsömn.'
    },
    {
        question: 'Hur många behandlingar behövs?',
        answer: 'Det är individuellt och beror på hur länge du haft problemen. Många märker en förbättring av sömnkvaliteten inom 5 behandlingar, men vid långvariga och kroniska sömnproblem kan en längre behandlingsperiod behövas.'
    },
    {
        question: 'Varför påverkas sömnen av stress och oro?',
        answer: 'När vi är stressade är kroppens "kamp- och flyktsystem" aktivt, vilket gör det svårt för hjärnan att ställa om till vila. Våra behandlingar hjälper till att aktivera kroppens lugn- och rosystem (det parasympatiska nervsystemet) så att återhämtning kan ske.'
    },
    {
        question: 'Finns det något jag kan göra själv för att få bättre sömn?',
        answer: 'Din delaktighet är viktig. Utöver våra behandlingar rekommenderar vi goda sömnvanor som att undvika skärmar innan läggdags och att etablera en nedvarvningsrutin. Att regelbundet praktisera Medicinsk Qigong är också ett utmärkt verktyg för att hantera stress i vardagen.'
    }
];
---

<BaseLayout title="Stress och sömnbesvär? Vi ger dig stöd till återhämtning i Nyköping & Gnesta | Medidraken"
  description="Svårt att sova på grund av stress eller spänningar? Få hjälp att förbättra din dygnsrytm och sömnkvalitet i Nyköping & Gnesta.">
    
    <SymptomHero
        title="Stress och sömnbesvär"
        subtitle="Få En Djupare & Återhämtande Sömn"
        image={heroImage}
        imageAlt="Stöd vid sömnproblem och svårt att sova"
        buttonText="Få Stöd till Bättre Sömn"
        buttonLink="/kontakt?subject=somnproblem"
    >
        Svårt att somna, orolig sömn eller vaknar du ofta för tidigt? 
        Långvariga sömnproblem försämrar energinivåerna, humöret och immunförsvaret. 
        Ofta är stress, obalans och spänningar viktiga underliggande faktorer till sömnproblem.
        Med TCM-behandling och träning kan vi hjälpa lugna nervsystemet, minska stress och 
        stödja kroppen att återfinna sin naturliga dygnsrytm så att du kan få en djupare återhämtande sömn.
    </SymptomHero>

    <SymptomMethodsThreeCol
        title="Hur vi Behandlar Sömnbesvär"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Vid sömnproblem är nervsystemet ofta överaktivt, vilket gör att kroppen har svårt att ställa om till vila.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Vi erbjuder kompletterande metoder för att hjälpa din kropp skifta från stress till återhämtning och återskapa en naturlig sömnrytm. De kan användas var för sig eller i kombination.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            Hör av dig så hittar vi rätt upplägg för dig.
        </p>
    </SymptomMethodsThreeCol>

    <SymptomCTA
        title="Få Hjälp Med Din Sömn"
        ctaButtonText="Hör av Dig & Boka Behandling"
        ctaSubject="somnproblem"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Vi stödjer din kropp att hitta tillbaka till en naturlig och vilsam sömn.
            
            Många av våra patienter upplever en förbättrad sömnkvalitet
            och lugnare känsla i kroppen inom 5 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Sömnproblem"
        faqs={faqs}
    />

</BaseLayout>
