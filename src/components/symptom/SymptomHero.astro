---
import { Image } from 'astro:assets';

interface Props {
    title: string;
    subtitle: string;
    image: ImageMetadata;
    imageAlt: string;
    buttonText: string;
    buttonLink: string;
}

const { title, subtitle, image, imageAlt, buttonText, buttonLink } = Astro.props;
---
<section class="hero-section">
    <div class="hero-background">
        <Image src={image} alt={imageAlt} class="hero-bg-image opacity-80" />
    </div>
    <div class="hero-content text-center">
        <h1 class="hero-title text-brand-earth-lighter max-w-4xl mx-auto">
            {title}
        </h1>
        <div class="hero-text bg-brand-earth-dark/50 p-4 md:p-6 rounded-lg backdrop-blur-sm border border-white/10 max-w-3xl mx-auto">
            <h2 class="hero-subtitle font-semibold text-white">{subtitle}</h2>
            <p class="hero-text text-white text-lg md:text-xl mt-2 leading-relaxed">
                <slot />
            </p>
        </div>
        
        <div class="mt-6 md:mt-10">
            <a href={buttonLink}
                class="btn btn-primary-on-dark shadow-lg shadow-black/10 px-8 py-4 text-lg inline-flex items-center">
                {buttonText}
            </a>
        </div>
    </div>
</section>
