---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SymptomHero from '../../components/symptom/SymptomHero.astro';
import SymptomMethodsThreeCol from '../../components/symptom/SymptomMethodsThreeCol.astro';
import SymptomCTA from '../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../assets/images/hero_immune.png';
import acupunctureImage from '../../assets/images/aku_doll6.png';
import tuinaManImage from '../../assets/images/tuina_girl_wide2.png';
import taichiImage from '../../assets/images/taichi_in_a_circle_instructor_johannes_teaching_several_white_crane_spreading_its_wings_grass_sunny_weather.jpg';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'TuiNa-massage löser upp djupa muskulära spänningar och blockeringar som hindrar kroppens naturliga förmåga till återhämtning. Genom att minska stress och främja cirkulation stödjer vi kroppens balans och återhämtningsförmåga.',
        image: tuinaManImage,
        alt: 'TuiNa-massage stärker kroppens vitalitet',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur hjälper nervsystemet att varva ner och bryta stresscykler. Genom att skapa ett djupt inre lugn får ditt immunförsvar en chans att återhämta sig.',
        image: acupunctureImage,
        alt: 'Akupunktur för ett starkare immunförsvar',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    },
    {
        title: 'Tai Chi & Qigong',
        desc: 'Praktiska verktyg med andning och rörelse för att hantera stress och minska trötthet. Detta hjälper dig att bygga upp ny energi så att du inte blir lika lätt mottaglig för nästa infektion.',
        image: taichiImage,
        alt: 'Tai Chi och Qigong stärker immunförsvaret inifrån',
        url: '/kurser',
        linkText: '→ Läs mer om vår träning',
        theme: 'accent' as const
    }
];

const faqs = [
    {
        question: 'Varför blir jag ofta sjuk när stressen släpper?',
        answer: 'När kroppen under lång tid varit i ett högstressläge prioriteras ofta återhämtningssystemen ned. När stressen väl släpper får immunförsvaret en chans att återhämta sig, vilket ibland kan yttra sig i att man blir sårbar för infektioner. Våra behandlingar syftar till att hjälpa kroppen att hitta en mer hållbar balans i vardagen, snarare än att bara reagera på stresstoppar.'
    },
    {
        question: 'Kan jag komma behandling när jag är förkyld?',
        answer: 'Vi arbetar främst förebyggande för att hjälpa dig bygga upp din inre balans och motståndskraft över tid. Om du har en pågående förkylning rekommenderar vi generellt vila. Vid kraftiga symtom eller hög feber bör du alltid låta kroppen vila och rådfråga vården.'
    },
    {
        question: 'Hur kan Tai Chi och Qigong hjälpa mig när jag lätt blir förkyld?',
        answer: 'Regelbundna övningar i Tai Chi och Qigong kombinerar rörelse, medveten andning och mental närvaro. Många upplever att detta är ett effektivt sätt att sänka stressnivåerna och förbättra den allmänna återhämtningen. När kroppen är i vila och balans har den bättre förutsättningar att fungera optimalt.'
    },
    {
        question: 'Kan akupunktur och TuiNa-massage bidra till bättre hälsa vid återkommande förkylningar?',
        answer: "Inom traditionell kinesisk medicin arbetar vi med att stärka kroppens balans och det vi kallar 'Wei Qi' – kroppens motståndskraft. Akupunktur och TuiNa-massage kan fungera som ett stödjande komplement för att skapa lugn och balans i kroppen, vilket många av våra klienter upplever ger dem bättre förutsättningar att hålla sig friska."
    },
    {
        question: 'Hur många behandlingar behövs för att se resultat?',
        answer: 'Det är individuellt hur kroppen svarar eftersom alla är olika. Att stärka kroppens inre motståndskraft och förbättra sin hälsa kan ta tid. Vi rekommenderar ofta en serie på 5–10 behandlingar för att ge kroppen kontinuitet och möjlighet att integrera effekterna av behandlingen.'
    }
];
---

<BaseLayout 
    title="Ofta Förkyld & Svagt Immunförsvar | Behandling i Nyköping"
    description="Känner du att du drar på dig varje förkylning som går? Vi hjälper dig att bryta mönstret och stärka din återhämtning. Välkommen till Medidraken."
>
    
    <SymptomHero
        title="Ofta Förkyld & Svagt Immunförsvar"
        subtitle="Få Hjälp Att Bryta Den Onda Cirkeln"
        image={heroImage}
        imageAlt="Behandling för dig som ofta blir förkyld"
        buttonText="Stöd Ditt Immunförsvar"
        buttonLink="/kontakt"
    >
        Känner du att du drar på dig varje förkylning som går, och att det tar ovanligt lång tid 
        att återhämta sig när du väl blivit sjuk? Långvarig stress och inre obalanser dränerar kroppens 
        förmåga att återhämta sig. Genom att lösa upp spänningar och sänka stressnivåerna med behandling och harmoniska träningsmetoder, ger vi ditt system goda förutsättningar att återhämta sig och hålla sig starkt över tid.
    </SymptomHero>

    <SymptomMethodsThreeCol
        title="Hur Vi Stödjer Din Återhämtning"
        methods={methods}
    >
        <div class="max-w-3xl mx-auto text-center mb-8 space-y-4">
            <p class="text-lg text-neutral-700 leading-relaxed">
                Kroppen har begränsade resurser, och om de ofta går åt till att hantera stress eller inre obalanser, orkar systemet inte alltid stå emot. 
                Våra metoder stödjer återhämtning, balans och hjälper systemet att slappna av och släppa på inre spänningar.
            </p>
            <p class="text-lg text-brand-earth font-medium">
                Hör av dig så hittar vi ett upplägg som hjälper dig framåt.
            </p>
        </div>
    </SymptomMethodsThreeCol>

    <SymptomCTA
        title="Få Hjälp Att Bli Mer Motståndskraftig"
        ctaButtonText="Hör av Dig & Boka Behandling"
        ctaSubject="ofta-forkyld"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Ett fritt energiflöde och låga stressnivåer skapar goda förutsättningar för vitalitet och ett starkt immunförsvar. 
            
            Många av våra klienter upplever en tydlig skillnad i sin allmänna hälsa och ork efter en period av regelbundna behandlingar och träning. 
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Immunförsvar & Förkylning"
        faqs={faqs}
    />

</BaseLayout>