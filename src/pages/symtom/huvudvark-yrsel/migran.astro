---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/hero_huvudvark3.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';
import tuinaImage from '../../../assets/images/tuina_head_woman.png';

const methods = [
    {
        title: 'Akupunktur',
        desc: 'Akupunktur är effektivt för att arbeta förebyggande mot migrän. Genom stimulering av specifika punkter hjälper vi dig att reglera nervsystemet, minska stress och balansera kroppen inifrån. Behandlingen kompletteras ofta med öronakupressur för att förlänga den balanserande effekten mellan besöken.',
        image: acupunctureImage,
        alt: 'Akupunktur för att förebygga migrän',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    },
    {
        title: 'TuiNa-massage',
        desc: 'För många är spänningar i nacke, axlar och käkar en stark trigger som kan utlösa ett migränanfall. Med djupgående TuiNa-massage arbetar vi specifikt med att lösa upp dessa muskelspänningar för att minska den fysiska belastningen och minska risken för att ett anfall överhuvudtaget startar.',
        image: tuinaImage,
        alt: 'TuiNa-massage mot spänningar som utlöser migrän',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    }
];

const faqs = [
    {
        question: 'Ska jag komma när jag har ett migränanfall?',
        answer: 'Det allra bästa är att arbeta förebyggande mellan anfallen. Om du redan har ett pågående anfall kan akupunktur ibland ge lindring, men huvudfokus för en hållbar lösning ligger alltid i den regelbundna, förebyggande behandlingen.'
    },
    {
        question: 'Hur ofta behöver jag gå på behandling?',
        answer: 'Det är individuellt och beror på din situation. En vanlig rekommendation är att börja med en serie behandlingar 1-3 gånger i veckan under en period, för att sedan successivt glesa ut intervallen i takt med att attackerna blir färre och svagare.'
    },
    {
        question: 'Jag har auras och är väldigt ljuskänslig, fungerar det ändå?',
        answer: 'Ja. Inom kinesisk medicin är symtom som aura, illamående och ljuskänslighet viktiga ledtrådar som hjälper oss att förstå den specifika obalans som orsakar just din migrän. Behandlingen anpassas för att hantera hela din symtombild, inte bara huvudvärken.'
    }
];
---

<BaseLayout 
    title="Behandling av Migrän i Nyköping, Gnesta och Oxelösund | Förebyggande | Medidraken"
    description="Få hjälp med din migrän. Vi arbetar förebyggande med akupunktur & TuiNa-massage för att minska anfallens frekvens, längd och intensitet."
>
    
    <SymptomHero
        title="Låt Oss Hjälpa Dig Med Din Migrän"
        subtitle="Förebyggande Behandling för Färre Anfall"
        image={heroImage}
        imageAlt="Förebyggande behandling av migrän"
        buttonText="Behandla Migrän"
        buttonLink="/kontakt"
    >
        Känner du kraftig, pulserande eller bultande huvudvärk? 
        </br>
        Migrän triggas ofta av stress, oro och ett känsligt nervsystem.
        Vi hjälper dig stärka kroppen och skapa förutsättningar 
        för att minska intensiteten, frekvensen och längden på dina migränanfall så att
        du kan få tillbaka din vardag och livskvalitet.
    </SymptomHero>

    <SymptomMethods
        title="Hur vi Behandlar Migrän"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Vi erbjuder två kompletterande metoder för att balansera nervsystemet och hjälpa kroppen att släppa 
            inre spänningar som byggts upp över tid. 
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            På så sätt ger vi din kropp 
            goda förutsättningar för att minska både antalet migränanfall och hur kraftfulla de blir. 
            Metoderna kan användas var för sig eller i kombination.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            Hör av dig så hittar vi tillsammans det upplägg som passar dig bäst.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Få Hjälp Med Din Migrän"
        ctaButtonText="Hör av Dig & Boka behandling"
        ctaSubject="migran"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Att få bukt med sin migrän är en process. Vi hjälper dig att skapa en förebyggande behandlingsplan. Många upplever en minskning av sina anfall inom 5 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Behandling av Migrän"
        faqs={faqs}
    />

</BaseLayout>
