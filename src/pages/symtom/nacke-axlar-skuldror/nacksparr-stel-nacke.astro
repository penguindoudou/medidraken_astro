---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/nackOCHaxelvark2.png';
import tuinaManImage from '../../../assets/images/tuina_man2.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'TuiNa mjukar varsamt upp stela muskler i nacke och axlar, ökar energi- och blodcirkulationen i området vilket ger de goda förutsättningar för minskad smärta och förbättrad rörlighet.',
        image: tuinaManImage,
        alt: 'TuiNa-massage för stela muskler',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur stimulerar kroppens energisystem för läkning, hjälper djupt liggande nack- och axelmuskler att slappna av och minskar de akuta smärtsignalerna.',
        image: acupunctureImage,
        alt: 'Akupunktur för nackspärr',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    }
];

const faqs = [
    {
        question: 'Är det farligt att behandla när det gör så ont?',
        answer: 'Behandlingen är säker och utförs alltid med stor försiktighet. Vi anpassar tekniker och tryck helt efter din smärtnivå. Att tidigt mjuka upp låsningen kan förkorta läkningsprocessen avsevärt.'
    },
    {
        question: 'Hur snabbt kan jag få en tid?',
        answer: 'Vid akuta besvär som nackspärr arbetar vi för att hitta en tid åt dig så snabbt som möjligt, ofta samma dag eller nästkommande vardag. Ring eller använd kontaktformuläret för att beskriva din situation och boka tid. Vi gör vad vi kan för att ta emot dig direkt.'
    }
];
---

<BaseLayout title="Behandling av Nackspärr & Stel Nacke i Nyköping | Medidraken"
  description="Akut hjälp vid nackspärr och stel nacke i Nyköping & Gnesta. Vi löser upp spända muskler och förbättrar rörligheten.">
    
    <SymptomHero
        title="Nackspärr & Stel Nacke"
        subtitle="Minska Smärta & Förbättra Rörlighet"
        image={heroImage}
        imageAlt="Behandling av Nackspärr och Stel Nacke"
        buttonText="Behandla Axlar"
        buttonLink="/kontakt?subject=nacksparr-stel-nacke"
    >
        Nackspärr kan göra de enklaste huvudrörelser smärtsamma och begränsande. 
        Det kan orsakas av att du sovit i en obekväm ställning, suttit i drag, gjort en plötslig rörelse eller stress.
        
        Med TCM:s behandlingsmetoder mjukar vi upp muskelspänningar och stärker 
        energisystemet så att smärtan i nacken och rörligheten får goda förutsättningar att förbättras.
    </SymptomHero>

    <SymptomMethods
        title="Hur vi Behandlar Nacken"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Vid nackspärr är musklerna ofta i kramp och nacken känns stel och låst.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-6">
            Vi erbjuder kompletterande metoder för att hjälpa din kropp släppa spänningarna och minska smärtan.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Få Hjälp Med Din Nackspärr"
        ctaButtonText="Behandla Nacke"
        ctaSubject="nacksparr-stel-nacke"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Vi prioriterar akuta besvär som nackspärr. Många upplever att smärtan börjar lätta och att rörligheten börjar komma tillbaka inom 3 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Behandling vid Nackspärr"
        faqs={faqs}
    />

</BaseLayout>
