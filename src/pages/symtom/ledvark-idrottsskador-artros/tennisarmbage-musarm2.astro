---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethodsThreeCol from '../../../components/symptom/SymptomMethodsThreeCol.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/armbagssmarta_hero.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';
import tuinaManImage from '../../../assets/images/tuina_girl_wide2.png';
import taichiImage from '../../../assets/images/taichi_hero6.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'TuiNa används för att lösa upp spänningar i underarmar, handleder och överarmar som är starkt bidragande till musarm och tennisarmbåge.',
        image: tuinaManImage,
        alt: 'TuiNa-massage mjukar upp muskelspänningar i underarmarna',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur är en effektiv metod för att stimulera blodcirkulationen och lugna inflammerade muskelfästen runt armbåge och handled.',
        image: acupunctureImage,
        alt: 'Akupunktur mot tennisarmbåge och handledssmärta',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    },
    {
        title: 'Tai Chi & Qigong',
        desc: 'Mjuka och skonsamma rörelser från Tai Chi och Medicinsk Qigong hjälper till att bibehålla rörlighet och cirkulation utan att överbelasta.',
        image: taichiImage,
        alt: 'Skonsam träning för armar och händer med Tai Chi och Qigong',
        url: '/kurser',
        linkText: '→ Läs mer om vår träning',
        theme: 'accent' as const
    }
];

const faqs = [
    {
        question: 'Vad är egentligen skillnaden på tennisarmbåge och golfarmbåge?',
        answer: 'Båda är överbelastningsskador, men smärtan sitter på olika ställen. Vid tennisarmbåge (lateral epikondylit) har du ont på armbågens utsida, medan golfarmbåge (medial epikondylit) ger smärta på armbågens insida.'
    },
    {
        question: 'Hjälper akupunktur mot domningar ut i fingrarna (karpaltunnelsyndrom)?',
        answer: 'Ja, domningar i fingrarna beror ofta på att nerver kommer i kläm på grund av spända muskler i underarm eller nacke/axel. Akupunktur och TuiNa-massage hjälper till att släppa dessa muskelspänningar vilket ofta minskar domningarna.'
    },
    {
        question: 'Måste jag sluta jobba framför datorn om jag har musarm?',
        answer: 'Nej, men det är viktigt att anpassa din ergonomi och ta korta pauser. Vi kombinerar behandling med att ge dig ergonomiska råd och enkla övningar du kan göra under arbetsdagen för att minska belastningen.'
    },
    {
        question: 'Hur lång tid tar det att bli bra från en tennisarmbåge?',
        answer: 'Det varierar beroende på hur länge du haft besvären. Eftersom senfästen läker långsamt kan det ta tid, men med rätt behandling brukar man märka en tydlig förbättring i smärta och funktion inom några behandlingstillfällen.'
    }
];
---

<BaseLayout title="Behandling av Tennisarmbåge, Musarm & Värk i Handleder i Nyköping | Medidraken">
    
    <SymptomHero
        title="Tennisarmbåge, Musarm & Värk i Handleder"
        subtitle="Minska Smärta & Förbättra Funktion"
        image={heroImage}
        imageAlt="Behandling av tennisarmbåge och handledsvärk"
        buttonText="Behandla Armbåge & Handled"
        buttonLink="/kontakt"
    >
        Har du ont på utsidan av armbågen, domningar i fingrarna eller värk i handleden? 
        Tennisarmbåge, golfarmbåge och musarm beror ofta på ensidiga rörelser och överbelastning. 
        Genom TCM-behandling kan vi hjälpa till att lösa upp spänningar i underarmarna 
        och påskynda kroppens egen läkning så du får goda förutsättningar till minskad smärta och fungerande armarna och händer.
    </SymptomHero>

    <SymptomMethodsThreeCol
        title="Behandla Orsaken till Överbelastningen"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Värk i armbåge och handleder påverkar nästan allt vi gör, från att lyfta ett mjölkpaket till att arbeta framför datorn.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            Våra behandlingar fokuserar på att både lindra den akuta smärtan vid senfästet 
            och att behandla de muskelspänningar i underarm och axel som ofta är grundorsaken till problemet.
        </p>
    </SymptomMethodsThreeCol>

    <SymptomCTA
        title="Få Hjälp Med Din Armbågs- eller Handledssmärta"
        ctaButtonText="Hör av Dig & Boka Behandling"
        ctaSubject="armbagssmarta"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Ju tidigare du söker hjälp för överbelastningsskador som tennisarmbåge, 
            desto snabbare går läkningen.  
             
            Många börjar uppleva en minskning i smärta och en mjukare, rörligare känsla inom 3 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Armbågs- & Handledsbesvär"
        faqs={faqs}
    />

</BaseLayout>
