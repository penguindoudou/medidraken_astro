---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { siteConfig } from '../data/site.ts';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { 
  title, 
  description = "Medidraken - Din väg till mindre smärta, mindre stress och mer energi med Traditionell Kinesisk Medicin.",
  noindex = false
} = Astro.props;

const displayTitle = title 
  ? (title.includes("Medidraken") ? title : `${title} | Medidraken`) 
  : "Medidraken | Akupunktur & TCM i Nyköping, Gnesta & Oxelösund";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/assets/images/og-social-v3.png', Astro.site);

const baseDescription = "Medidraken erbjuder akupunktur, Tui Na-massage, Tai Chi och medicinsk Qigong inom traditionell kinesisk medicin (TCM) i Nyköping, Gnesta och Oxelösund. Vi erbjuder även företagsbehandlingar på plats hos er.";

const openingHoursSpec = [
  {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "09:00",
    "closes": "20:00"
  }
];

// All services require booking — split into personal and corporate actions.
const bookingAction = [
  {
    "@type": "ReserveAction",
    "name": "Boka tid hos Medidraken",
    "description": "Alla personliga tjänster sker på bokad tid — kurser, privatbehandlingar, privat träning, workshops, hälsoresor, skräddarsydda hälsodagar och övriga önskemål.",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteConfig.url}/kontakt`,
      "actionPlatform": [
        "http://schema.org/DesktopWebPlatform",
        "http://schema.org/MobileWebPlatform",
        "http://schema.org/IOSPlatform",
        "http://schema.org/AndroidPlatform"
      ]
    },
    "result": {
      "@type": "Reservation",
      "name": "Bokad tid hos Medidraken"
    }
  },
  {
    "@type": "ReserveAction",
    "name": "Företagsförfrågan & offert",
    "description": "Företag kan boka TCM-behandlingar på arbetsplatsen, skräddarsydda hälsodagar och andra företagsupplevelser. Kontakta oss för offert.",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteConfig.url}/for-foretag/kontakt-offert/`,
      "actionPlatform": [
        "http://schema.org/DesktopWebPlatform",
        "http://schema.org/MobileWebPlatform",
        "http://schema.org/IOSPlatform",
        "http://schema.org/AndroidPlatform"
      ]
    },
    "result": {
      "@type": "Reservation",
      "name": "Offertförfrågan för företag"
    }
  }
];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteConfig.url}/#website`,
  "url": siteConfig.url,
  "name": siteConfig.name,
  "description": baseDescription,
  "inLanguage": "sv-SE",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteConfig.url}/?s={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteConfig.url}/#organization`,
  "name": siteConfig.name,
  "url": siteConfig.url,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteConfig.url}/assets/images/medidraken-logo_white_background.png`,
    "width": 400,
    "height": 400
  },
  "image": ogImageURL.toString(),
  "description": baseDescription,
  "email": siteConfig.email,
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": siteConfig.phones.linnea.clean,
      "contactType": "customer service",
      "areaServed": "SE",
      "availableLanguage": "Swedish",
      "hoursAvailable": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "09:00",
        "closes": "20:00"
      }
    },
    {
      "@type": "ContactPoint",
      "telephone": siteConfig.phones.johannes.clean,
      "contactType": "sales",
      "areaServed": "SE",
      "availableLanguage": "Swedish",
      "contactOption": "TollFree"
    }
  ],
  "sameAs": [
    siteConfig.social.facebook
  ],
  "makesOffer": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Akupunktur",
        "serviceType": "Acupuncture"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Tui Na-massage",
        "serviceType": "Traditional Chinese Massage"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Tai Chi",
        "serviceType": "Tai Chi"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Medicinsk Qigong",
        "serviceType": "Medical Qigong"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Företagsbehandling på plats",
        "serviceType": "Corporate Wellness",
        "description": "Vi kommer till er arbetsplats och erbjuder TCM-behandlingar för anställda."
      }
    }
  ]
};

const localBusinessSchema = [
  websiteSchema,
  organizationSchema,
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "@id": `${siteConfig.url}/#nykoping`,
    "name": "Medidraken - Nyköping",
    "description": `Akupunktur, Tui Na-massage, Tai Chi och medicinsk Qigong i Nyköping. Medidraken erbjuder TCM-behandlingar på Östra Storgatan 2, 611 34 Nyköping. Företagsbehandlingar på plats möjliga.`,
    "image": ogImageURL.toString(),
    "url": siteConfig.url,
    "telephone": siteConfig.phone.clean,
    "email": siteConfig.email,
    "priceRange": "$$",
    "medicalSpecialty": ["Acupuncture", "Physical Medicine", "Preventive Medicine"],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": siteConfig.addresses.nykoping.street,
      "addressLocality": siteConfig.addresses.nykoping.city,
      "postalCode": siteConfig.addresses.nykoping.zip,
      "addressCountry": "SE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 58.7533088,
      "longitude": 17.0006764
    },
    "hasMap": siteConfig.addresses.nykoping.mapUrl,
    "areaServed": [
      { "@type": "City", "name": "Nyköping" },
      { "@type": "City", "name": "Gnesta" },
      { "@type": "City", "name": "Oxelösund" }
    ],
    "openingHoursSpecification": openingHoursSpec,
    "potentialAction": bookingAction,
    "parentOrganization": { "@id": `${siteConfig.url}/#organization` },
    "sameAs": [
      siteConfig.addresses.nykoping.mapUrl,
      siteConfig.social.facebook
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "@id": `${siteConfig.url}/#gnesta`,
    "name": "Medidraken - Gnesta",
    "description": `Akupunktur, Tui Na-massage, Tai Chi och medicinsk Qigong i Gnesta. Medidraken erbjuder TCM-behandlingar på Dalgatan 20, 646 32 Gnesta. Företagsbehandlingar på plats möjliga.`,
    "image": ogImageURL.toString(),
    "url": siteConfig.url,
    "telephone": siteConfig.phone.clean,
    "email": siteConfig.email,
    "priceRange": "$$",
    "medicalSpecialty": ["Acupuncture", "Physical Medicine", "Preventive Medicine"],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": siteConfig.addresses.gnesta.street,
      "addressLocality": siteConfig.addresses.gnesta.city,
      "postalCode": siteConfig.addresses.gnesta.zip,
      "addressCountry": "SE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 59.0494875,
      "longitude": 17.3056093
    },
    "hasMap": siteConfig.addresses.gnesta.mapUrl,
    "areaServed": [
      { "@type": "City", "name": "Nyköping" },
      { "@type": "City", "name": "Gnesta" },
      { "@type": "City", "name": "Oxelösund" }
    ],
    "openingHoursSpecification": openingHoursSpec,
    "potentialAction": bookingAction,
    "parentOrganization": { "@id": `${siteConfig.url}/#organization` },
    "sameAs": [
      siteConfig.addresses.gnesta.mapUrl,
      siteConfig.social.facebook
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "@id": `${siteConfig.url}/#oxelosund`,
    "name": "Medidraken - Oxelösund",
    "description": `Akupunktur, Tui Na-massage, Tai Chi och medicinsk Qigong i Oxelösund. Medidraken erbjuder TCM-behandlingar på Föreningsgatan 30, 613 31 Oxelösund. Företagsbehandlingar på plats möjliga.`,
    "image": ogImageURL.toString(),
    "url": siteConfig.url,
    "telephone": siteConfig.phone.clean,
    "email": siteConfig.email,
    "priceRange": "$$",
    "medicalSpecialty": ["Acupuncture", "Physical Medicine", "Preventive Medicine"],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": siteConfig.addresses.oxelosund.street,
      "addressLocality": siteConfig.addresses.oxelosund.city,
      "postalCode": siteConfig.addresses.oxelosund.zip,
      "addressCountry": "SE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 58.6698654,
      "longitude": 17.0984183
    },
    "hasMap": siteConfig.addresses.oxelosund.mapUrl,
    "areaServed": [
      { "@type": "City", "name": "Nyköping" },
      { "@type": "City", "name": "Gnesta" },
      { "@type": "City", "name": "Oxelösund" }
    ],
    "openingHoursSpecification": openingHoursSpec,
    "potentialAction": bookingAction,
    "parentOrganization": { "@id": `${siteConfig.url}/#organization` },
    "sameAs": [
      siteConfig.addresses.oxelosund.mapUrl,
      siteConfig.social.facebook
    ]
  }
];
---
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/assets/images/medidraken-logo_white_background.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Basics -->
    <title>{displayTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="sv_SE" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={displayTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <!-- Cloudflare Web Analytics -->
    {import.meta.env.PUBLIC_CLOUDFLARE_TOKEN && (
      <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CLOUDFLARE_TOKEN}"}`}></script>
    )}
    <!-- End Cloudflare Web Analytics -->

    { (Astro.url.pathname === '/' || Astro.url.pathname === '/index.html') && (
      <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    ) }
  </head>
  <body class="bg-neutral-100 text-neutral-700 font-body antialiased selection:bg-brand-accent selection:text-white">
    <Header />
    
    <slot />

    <Footer />
  </body>
</html>
