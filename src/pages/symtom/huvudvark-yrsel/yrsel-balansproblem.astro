---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/hero_huvudvark3.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';
import tuinaImage from '../../../assets/images/tuina_head_woman.png';

const methods = [
    {
        title: 'Akupunktur',
        desc: 'Akupunktur är effektivt för att lugna nervsystemet och återställa kroppens inre balans. Genom att behandla specifika punkter hjälper vi till att reglera nervsystemet, förbättra cirkulationen och minska stress.',
        image: acupunctureImage,
        alt: 'Akupunktur för att behandla yrsel och återställa balans',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    },
    {
        title: 'TuiNa-massage',
        desc: 'Yrsel och balansproblem är ofta kopplade till kraftiga spänningar i nacke, axlar och käkar som påverkar blodflödet och nerverna upp till huvudet. Med TuiNa-massage mjukar vi upp dessa muskelspänningar och förbättrar cirkulationen till huvudet.',
        image: tuinaImage,
        alt: 'TuiNa-massage mot spänningar som utlöser yrsel',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    }
];

const faqs = [
    {
        question: 'Kan spänningar i nacken verkligen orsaka yrsel?',
        answer: 'Ja, det är mycket vanligt. Så kallad cervikogen yrsel uppstår när stela muskler och leder i nacken påverkar nervsystemets och kroppens förmåga att tolka balanssignaler. Genom att lösa upp dessa spänningar kan yrseln ofta minska avsevärt.'
    },
    {
        question: 'Hur många behandlingar behövs innan det blir bättre?',
        answer: 'Det är individuellt och beror på hur länge du haft besvären och vad som orsakar dem. Många upplever minskad yrsel och ökad stabilitet och balans redan efter 5 behandlingar. Vi sätter ihop en behandlingsplan för dig.'
    },
    {
        question: 'Kan stress orsaka yrsel och balansproblem?',
        answer: 'Stress påverkar hela nervsystemet och kan göra att kroppens balanssystem blir överkänsligt. Både akupunktur och TuiNa-massage är djupt avslappnande metoder som hjälper till att sänka stressnivåerna och återhämta nervsystemet, vilket ofta har en mycket positiv effekt på stressrelaterad yrsel.'
    }
];
---

<BaseLayout 
    title="Behandling av Yrsel & Balansproblem i Nyköping, Gnesta och Oxelösund | Medidraken"
    description="Få hjälp med yrsel och balansproblem. Vi arbetar med akupunktur & TuiNa-massage för att minska spänningar och återställa kroppens naturliga balans."
>
    
    <SymptomHero
        title="Få Hjälp Med Din Yrsel"
        subtitle="Behandling för Återställd Balans och Trygghet"
        image={heroImage}
        imageAlt="Behandling av yrsel och balansproblem"
        buttonText="Behandla Yrsel"
        buttonLink="/kontakt"
    >
        Känner du dig ostadig, snurrig eller har svårt att hålla balansen? 
        </br>
        Yrsel kan bero på spänningar i nacke och axlar, stress eller obalanser i nervsystemet.
        Vi hjälper dig att släppa djupliggande spänningar och stärka kroppens naturliga balans så att 
        du kan känna dig trygg i din vardag igen.
    </SymptomHero>

    <SymptomMethods
        title="Hur vi Behandlar Yrsel & Balansproblem"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Vi erbjuder två kompletterande metoder för att balansera nervsystemet och hjälpa kroppen att släppa 
            inre spänningar som byggts upp över tid. 
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            På så sätt ger vi din kropp 
            goda förutsättningar för att minska både din yrsel och eventuella spänningar i kroppen. 
            Metoderna kan användas var för sig eller i kombination.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            Hör av dig så hittar vi tillsammans det upplägg som passar dig bäst.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Låt Oss Hjälpa Dig Med Din Yrsel"
        ctaButtonText="Hör av Dig & Boka behandling"
        ctaSubject="yrsel-balansproblem"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Att behandla yrsel är en process. Många börjar uppleva minskad yrsel och förbättrad stabilitet inom 5 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Behandling av Yrsel"
        faqs={faqs}
    />

</BaseLayout>
