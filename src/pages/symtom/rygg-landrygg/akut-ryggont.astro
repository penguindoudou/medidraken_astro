---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';

// Images
import heroImage from '../../../assets/images/ryggvark_hero5.png';
import tuinaManImage from '../../../assets/images/tuina_man2.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Jag har så ont att jag knappt kan röra mig, kan jag verkligen få behandling?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, absolut. Vi är vana vid att behandla akuta tillstånd. Behandlingen anpassas helt efter din smärtnivå och rörelseförmåga. Ofta kan vi utföra behandlingen i en position som är så bekväm som möjligt för dig, till exempel sittande eller liggande mage eller sidan."
      }
    },
    {
      "@type": "Question",
      "name": "Hur snabbt kan jag få en tid?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vid akuta besvär som ryggskott arbetar vi för att hitta en tid åt dig så snabbt som möjligt, ofta samma dag eller nästkommande vardag. Ring eller maila oss och förklara din situation så gör vi vad vi kan för att ta emot dig direkt."
      }
    },
    {
      "@type": "Question",
      "name": "Vad kan jag själv göra för att förebygga så att jag inte får ryggont igen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "När vi har minskat den akuta smärtan är det viktigt att du stärker muskulaturen. Regelbunden praktik av Tai Chi och Qigong är utmärkta verktyg för att bygga en stark, balanserad och stabil grund på lång sikt."
      }
    }
  ]
};
---

<BaseLayout title="Behandling av Akut Ryggskott i Nyköping, Gnesta och Oxelösund | Effektiv Hjälp | Medidraken"
  description="Få snabb och effektiv hjälp vid akut ryggskott och ryggont i Nyköping, Gnesta och Oxelösund. Boka tid hos Medidraken.">
    <!-- ======================================= -->
    <!-- Sektion 1: Hero – Toppsektion           -->
    <!-- ======================================= -->
    <section class="hero-section">
        <div class="hero-background">
            <Image src={heroImage} alt="Akut Ryggskott Behandling" class="hero-bg-image opacity-80" />
        </div>
        <div class="hero-content text-center">
            <h1 class="hero-title text-brand-earth-lighter max-w-4xl mx-auto">
                Akut Ryggskott
            </h1>
            <div class="hero-text bg-brand-earth-dark/50 p-4 md:p-6 rounded-lg backdrop-blur-sm border border-white/10 max-w-3xl mx-auto">
                <h2 class="hero-subtitle font-semibold text-white">Minska Smärta & Förbättra Rörligheten</h2>
                <p class="hero-text text-brand-earth-lightest text-lg md:text-xl mt-2 leading-relaxed">
                    Ryggskott kommer ofta plötsligt och kan vara oerhört smärtsamt och begränsande. Det kan bero på orsaker som plötslig överbelastning, stillasittande under längre perioder och bristande hållning och stress.
                    
                    Med TCM:s behandlingsmetoder mjukar vi upp muskelspänningar och stärker energisystem så att din rygg får goda förutsättningar för minskad smärta och förbättrad funktion.
            </div>
            
            <div class="mt-6 md:mt-10">
                <a href="/kontakt?subject=akut-ryggont"
                    class="btn btn-primary-on-dark shadow-lg shadow-black/10 px-8 py-4 text-lg inline-flex items-center">
                    Behandla Rygg
                </a>
            </div>
        </div>
    </section>

    <!-- ======================================= -->
    <!-- Sektion 2: Våra Rekommenderade Metoder  -->
    <!-- ======================================= -->
    <section id="behandlingsmetoder" class="bg-white section-standard">
        <div class="container-base">
            <div class="text-center mb-16 max-w-4xl mx-auto">
                <h2 class="text-brand-earth mb-6">Hur vi Behandlar Akut Ryggvärk</h2>

                <div class="mt-8 mb-10">
                    
                    <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
                        Vid ett akut ryggskott är musklerna ofta i kramp och hela området är låst. 
                        
                    </p>
                    <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-6">
                        Vi erbjuder kompletterande metoder för att hjälpa din kropp släppa spänningarna och minska smärtan. 
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 max-w-6xl mb-10 mx-auto">

                <!-- Kort 1: TuiNa -->
                <div class="service-card h-full bg-brand-accent/5 border border-brand-accent/20">
                    <div class="relative overflow-hidden group">
                        <Image src={tuinaManImage} alt="TuiNa-massage för att lösa akuta låsningar"
                            class="card-image transition-transform duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-earth/10 group-hover:bg-transparent transition-colors duration-300"></div>
                    </div>
                    <div class="card-content flex flex-col flex-grow">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-brand-accent/20 text-brand-earth-dark text-xl font-bold shrink-0">1</div>
                            <h4 class="card-title text-2xl font-bold text-brand-earth-dark m-0">TuiNa-massage</h4>
                        </div>
                        <p class="card-text mt-2 text-neutral-700 leading-relaxed flex-grow">
                            TuiNa mjukar varsamt upp stela muskler, ökar energi- och blodcirkulationen i området vilket stärker ryggens egna läkningsförmåga och ger goda förutsättningar för minskad smärta och förbättrad rörlighet.
                        </p>
                        <div class="mt-8 pt-6 border-t border-brand-accent/20 flex flex-col gap-4">
                            <a href="/behandling/tuina-massage/" class="text-lg font-medium text-brand-sky hover:text-brand-accent-dark transition-colors flex items-center group/link">
                                &rarr; Läs mer om TuiNa-Massage
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Kort 2: Akupunktur -->
                <div class="service-card h-full bg-brand-sky/5 border border-brand-sky/20">
                    <div class="relative overflow-hidden group">
                        <Image src={acupunctureImage} alt="Akupunktur för ryggskott"
                            class="card-image transition-transform duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-earth/10 group-hover:bg-transparent transition-colors duration-300"></div>
                    </div>
                    <div class="card-content flex flex-col flex-grow">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-brand-sky/20 text-brand-sky-dark text-xl font-bold shrink-0">2</div>
                            <h4 class="card-title text-2xl font-bold text-brand-sky-dark m-0">Akupunktur</h4>
                        </div>
                        <p class="card-text mt-2 text-neutral-700 leading-relaxed flex-grow">
                            Akupunktur stimulerar och stärker kroppens energisystem och egna läkningsförmåga för att ge goda förutsättningar för att minska smärtan. 
                        </p>
                        <div class="mt-8 pt-6 border-t border-brand-sky/20 flex flex-col gap-4">
                            <a href="/behandling/akupunktur/" class="text-lg font-medium text-brand-sky hover:text-brand-accent-dark transition-colors flex items-center group/link">
                                &rarr; Läs mer om Akupunktur
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ======================================= -->
    <!-- Sektion 3 & 4: CTA och Praktisk Info    -->
    <!-- ======================================= -->
    <section class="bg-brand-earth-light section-standard text-center">
        <div class="container-base max-w-4xl">

            <!-- Huvud CTA -->
            <div class="max-w-3xl mx-auto mb-16">
                <h2 class="text-brand-earth-dark mb-6 text-3xl md:text-5xl">Få Hjälp Med Ditt Ryggskott</h2>
                <div class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-10 space-y-4">
                    <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
                        Vi prioriterar akuta besvär som ryggskott. Många upplever att smärtan börjar lätta och att rörligheten förbättras inom 3 behandlingar.
                    </p>
                </div>

                <a href="/kontakt?subject=akut-ryggont#tidsbokning"
                    class="btn btn-primary-on-dark shadow-lg shadow-black/10 px-10 py-5 text-xl mb-0">
                    Hör av Dig & Boka Behandling
                </a>
            </div>

            <!-- Trust & Info Row (Discrete boxes with icon containers) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 pt-6 mt-0 border-t border-brand-earth-dark/10">

                <!-- Column 1: Praktisk Info -->
                <div class="group bg-brand-earth-dark/5 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border-2 border-brand-earth-dark/10 flex flex-col items-start text-left">
                    <div class="flex items-center mb-4">
                        <div class="flex items-center justify-center h-10 w-10 rounded-full bg-brand-earth-dark/25 mr-3">
                            <div class="relative flex h-3 w-3 items-center justify-center">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-accent"></span>
                            </div>
                        </div>
                        <span class="font-bold text-brand-earth-dark text-xl">Mottagningar</span>
                    </div>
                    <div class="text-neutral-700 leading-relaxed text-sm md:text-base flex-grow">
                        Vi hjälper dig att med ditt ryggskott på våra mottagningar i <a href="/kontakt/#mottagningar" class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Nyköping</a>, <a href="/kontakt/#mottagningar" class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Gnesta</a> och <a href="/kontakt/#mottagningar" class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Oxelösund</a>. Alla besök sker efter tidsbokning.
                    </div>
                    <a href="/kontakt/#mottagningar"
                        class="text-brand-sky hover:text-brand-sky-dark font-medium flex items-center mt-4 group-hover:translate-x-1 transition-transform">Se
                        alla mottagningar &rarr;</a>
                </div>

                <!-- Column 2: Friskvård -->
                <div class="group bg-brand-earth-dark/5 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border-2 border-brand-earth-dark/10 flex flex-col items-start text-left">
                    <div class="flex items-center mb-4">
                        <div class="flex items-center justify-center h-10 w-10 rounded-full bg-brand-earth-dark/25 text-brand-accent mr-3">
                            <Icon name="shield_health" class="h-6 w-6" />
                        </div>
                        <span class="font-bold text-brand-earth-dark text-xl">Friskvårdsbidrag</span>
                    </div>
                    <div class="text-neutral-700 leading-relaxed text-sm md:text-base flex-grow">
                        Använd ditt bidrag! Alla våra behandlingar är godkända.<br />
                    </div>
                    <a href="/friskvardsbidrag/" class="text-brand-sky hover:text-brand-sky-dark font-medium flex items-center mt-4 group-hover:translate-x-1 transition-transform">Läs mer &rarr;</a>
                </div>

                <!-- Column 3: Presentkort -->
                <div class="group bg-brand-earth-dark/5 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border-2 border-brand-earth-dark/10 flex flex-col items-start text-left">
                    <div class="flex items-center mb-4">
                        <div class="flex items-center justify-center h-10 w-10 rounded-full bg-brand-earth-dark/25 text-brand-accent mr-3">
                            <Icon name="present" class="h-6 w-6" />
                        </div>
                        <span class="font-bold text-brand-earth-dark text-xl">Presentkort</span>
                    </div>
                    <div class="text-neutral-700 leading-relaxed text-sm md:text-base flex-grow">
                        Ge bort en terapeutisk behandling med presentkort.<br />
                    </div>
                    <a href="/presentkort/" class="text-brand-sky hover:text-brand-sky-dark font-medium flex items-center mt-4 group-hover:translate-x-1 transition-transform">Läs mer &rarr;</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ======================================= -->
    <!-- Sektion 5: FAQ                          -->
    <!-- ======================================= -->
    <section class="section-standard bg-white">
        <div class="container-base max-w-3xl">
            <h2 class="text-brand-earth text-center mb-12">Vanliga Frågor om Behandling av Ryggskott</h2>

            <div class="space-y-4" x-data="{ active: null }">

                <!-- Fråga 1 -->
                <div class="border border-neutral-200 rounded-lg overflow-hidden">
                    <button @click="active === 1 ? active = null : active = 1"
                        class="w-full flex justify-between items-center p-5 bg-neutral-50 hover:bg-neutral-100 transition-colors focus:outline-none focus:bg-brand-accent/30">
                        <span class="font-bold text-brand-earth text-left">Jag har så ont att jag knappt kan röra mig, kan jag verkligen få behandling?</span>
                        <span class="ml-4 text-brand-sky transform transition-transform"
                            :class="active === 1 ? 'rotate-180' : ''">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </button>
                    <div x-show="active === 1" x-collapse x-cloak
                        class="p-5 bg-white text-neutral-700 leading-relaxed border-t border-neutral-100">
                        Ja, absolut. Vi är vana vid att behandla akuta tillstånd. Behandlingen anpassas helt efter din smärtnivå och rörelseförmåga. Ofta kan vi utföra behandlingen i en position som är så bekväm som möjligt för dig, till exempel sittande eller liggande mage eller sidan.
                    </div>
                </div>

                <!-- Fråga 2 -->
                <div class="border border-neutral-200 rounded-lg overflow-hidden">
                    <button @click="active === 2 ? active = null : active = 2"
                        class="w-full flex justify-between items-center p-5 bg-neutral-50 hover:bg-neutral-100 transition-colors focus:outline-none focus:bg-brand-accent/30">
                        <span class="font-bold text-brand-earth text-left">Hur snabbt kan jag få en tid?</span>
                        <span class="ml-4 text-brand-sky transform transition-transform"
                            :class="active === 2 ? 'rotate-180' : ''">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </button>
                    <div x-show="active === 2" x-collapse x-cloak
                        class="p-5 bg-white text-neutral-700 leading-relaxed border-t border-neutral-100">
                        Vid akuta besvär som ryggskott arbetar vi för att hitta en tid åt dig så snabbt som möjligt, ofta samma dag eller nästkommande vardag. Ring eller maila oss och förklara din situation så gör vi vad vi kan för att ta emot dig direkt.
                    </div>
                </div>

                <!-- Fråga 3 -->
                <div class="border border-neutral-200 rounded-lg overflow-hidden">
                    <button @click="active === 3 ? active = null : active = 3"
                        class="w-full flex justify-between items-center p-5 bg-neutral-50 hover:bg-neutral-100 transition-colors focus:outline-none focus:bg-brand-accent/30">
                        <span class="font-bold text-brand-earth text-left">Vad kan jag själv göra för att förebygga så att jag inte får ryggont igen?</span>
                        <span class="ml-4 text-brand-sky transform transition-transform"
                            :class="active === 3 ? 'rotate-180' : ''">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </button>
                    <div x-show="active === 3" x-collapse x-cloak
                        class="p-5 bg-white text-neutral-700 leading-relaxed border-t border-neutral-100">
                        När vi har minskat den akuta smärtan är det viktigt att du stärker muskulaturen. Regelbunden praktik av Tai Chi och Qigong är utmärkta verktyg för att bygga en stark, balanserad och stabil grund på lång sikt.
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- FAQ Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
