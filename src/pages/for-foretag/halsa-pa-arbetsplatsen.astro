---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

// Images (Using available placeholders - can be swapped later if needed)
import placeholder1 from '../../assets/images/qigong_johannes_instructing_group.jpg';
import placeholder2 from '../../assets/images/tuina_girl_wide2.png';
import heroImage from '../../assets/images/taichi_in_a_circle_instructor_johannes_teaching_several_white_crane_spreading_its_wings_grass_sunny_weather.jpg';
---

<BaseLayout title="Friskvård för Företag i Nyköping | Medicinsk Qigong, Tai Chi & Behandling | Medidraken" description="Hälsofrämjande insatser direkt på er arbetsplats i Nyköping och Gnesta. Medicinsk Qigong, Tai Chi och behandling anpassat för era medarbetare.">
    <!-- ======================================= -->
    <!-- Sektion 1: Hero                         -->
    <!-- ======================================= -->
    <section class="hero-section">
        <div class="hero-background">
            <Image src={heroImage} alt="Hälsa på Arbetsplatsen" class="hero-bg-image" />
        </div>

        <div class="hero-content">
            <h1 class="hero-title text-brand-accent">Hälsa på Arbetsplatsen</h1>
            
            <div class="hero-text bg-brand-earth-dark/40 p-4 md:p-6 rounded-lg backdrop-blur-sm border border-white/10">
            <h2 class="hero-subtitle font-semibold">En Miljö för Välbefinnande och Produktivitet</h2>    
                <p class="hero-text mt-2 text-white/95">
                    Skapa en friskare, mer harmonisk och produktiv arbetsplats med regelbundna hälsoinsatser. Vi erbjuder proaktiva lösningar som hjälper er personal att hantera stress och förebygga arbetsrelaterade besvär.
                </p>
            </div>
            
            <div class="mt-6 md:mt-10">
                <a href="#tjanster" class="btn btn-primary-on-dark">
                    Läs mer om våra tjänster
                </a>
            </div>
        </div>
    </section>

    <!-- ======================================= -->
    <!-- Sektion 2: Våra Regelbundna Tjänster    -->
    <!-- ======================================= -->
    <section id="tjanster" class="bg-white py-16 md:py-24">
        <div class="container-base max-w-6xl">
            <h2 class="text-brand-earth-dark mb-12 text-center text-3xl md:text-5xl">Vad behöver din personal?</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
                <!-- Kort 1: Proaktiv Träning -->
                <div class="bg-brand-accent/20 rounded-2xl shadow-lg border border-brand-accent/10 flex flex-col group hover:shadow-xl transition-all duration-300">
                    <div class="h-64 overflow-hidden relative rounded-t-2xl">
                        <Image src={placeholder1} alt="Medicinsk Qigong & Tai Chi på Jobbet" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-earth-dark/10 group-hover:bg-brand-earth-dark/0 transition-colors duration-500"></div>
                    </div>
                    
                    <div class="p-8 flex flex-col flex-grow">
                        <div class="mb-4">
                            <span class="text-brand-accent-dark font-semibold tracking-wider uppercase text-sm">Praktisk Stresshantering & Harmoni</span>
                        </div>
                        <h3 class="text-2xl md:text-3xl font-heading text-brand-earth-dark mb-4">Medicinsk Qigong & Tai Chi</h3>
                        
                        <p class="text-neutral-700 mb-6 leading-relaxed">
                            Ge personalen möjlighet för mer energi, återhämtning och uppmuntran till bättre hälsa. Vi håller 45-60 minuters pass hos er eller i våra lokaler.
                        </p>

                        <div class="mb-8">
                            <ul class="space-y-3">
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Minskad stress & ökat fokus</span>
                                </li>
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Bättre samarbete & teamkänsla</span>
                                </li>
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Uppskattad gemensam aktivitet</span>
                                </li>
                            </ul>
                        </div>

                        <div class="mt-auto pt-6 border-t border-brand-earth-dark/5">
                            <a href="/for-foretag/kontakt-offert/?type=friskvard&subtype=qigong#offert" class="btn bg-brand-accent text-brand-earth-dark hover:bg-brand-accent-dark hover:-translate-y-1 transition-transform shadow-md rounded-lg py-3 px-6 font-semibold w-full flex justify-center text-center">
                                Begär Offert för Qigong/Tai Chi
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Kort 2: Förebyggande & Reaktiv Vård -->
                <div class="bg-brand-accent/20 rounded-2xl shadow-lg border border-brand-accent/10 flex flex-col group hover:shadow-xl transition-all duration-300">
                    <div class="h-64 overflow-hidden relative rounded-t-2xl">
                        <Image src={placeholder2} alt="Behandlingar på Plats" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-earth-dark/10 group-hover:bg-brand-earth-dark/0 transition-colors duration-500"></div>
                    </div>
                    
                    <div class="p-8 flex flex-col flex-grow">
                        <div class="mb-4">
                            <span class="text-brand-accent-dark font-semibold tracking-wider uppercase text-sm">För Personal Med Smärta & Stress</span>
                        </div> 
                        <h3 class="text-2xl md:text-3xl font-heading text-brand-earth-dark mb-4">Behandlingar på Plats</h3>
                        
                        <p class="text-neutral-700 mb-6 leading-relaxed">
                            Vi kommer till er med behandlingsbänk. Personalen bokar korta, effektiva behandlingar för att åtgärda problem snabbt, innan de blir allvarliga.
                        </p>

                        <div class="mb-8">
                            <ul class="space-y-3">
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Förebygger arbetsrelaterade besvär</span>
                                </li>
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Lindrar "kontorsnacke" & musarm</span>
                                </li>
                                <li class="flex items-start">
                                    <Icon name="check-circle" class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" />
                                    <span class="text-neutral-600">Minskad sjukfrånvaro & ökat välmående</span>
                                </li>
                            </ul>
                        </div>

                        <div class="mt-auto pt-6 border-t border-brand-earth-dark/5">
                            <a href="/for-foretag/kontakt-offert/?type=friskvard&subtype=behandlingar#offert" class="btn bg-brand-accent text-brand-earth-dark hover:bg-brand-accent-dark hover:-translate-y-1 transition-transform shadow-md rounded-lg py-3 px-6 font-semibold w-full flex justify-center text-center">
                                Begär Offert för Behandlingar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ======================================= -->
    <!-- Sektion 3: Praktisk Information (CTA)   -->
    <!-- ======================================= -->
    <section class="bg-brand-earth-light section-standard text-center">
        <div class="container-base max-w-4xl">

            <!-- Huvud CTA -->
            <div class="max-w-3xl mx-auto mb-16">
                <h2 class="text-brand-earth-dark mb-6 text-3xl md:text-5xl">Förbättra Personalens Hälsa & Arbetsglädje</h2>
                <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-10">
                    Vi levererar våra tjänster på plats hos er eller i våra egna lokaler. 
                    Om du har frågor eller specifika önskemål, kontakta oss för att diskutera ett upplägg och få en offert.
                </p>

                <a href="/for-foretag/kontakt-offert/?type=friskvard#offert"
                    class="btn btn-primary-on-dark shadow-lg shadow-black/10 px-10 py-5 text-xl mb-0">
                    Kontakta Oss
                </a>
            </div>

            <!-- Trust & Info Row (Discrete boxes with icon containers) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 pt-6 mt-0 border-t border-brand-earth-dark/10 max-w-3xl mx-auto">
                
                <!-- Column 1: Platser -->
                <div
                    class="group bg-brand-earth-dark/5 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border-2 border-brand-earth-dark/10 flex flex-col items-start text-left">
                    <div class="flex items-center mb-4">
                        <div
                            class="flex items-center justify-center h-10 w-10 rounded-full bg-brand-earth-dark/25 mr-3">
                            <div class="relative flex h-3 w-3 items-center justify-center">
                                <span
                                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-accent"></span>
                            </div>
                        </div>
                        <span class="font-bold text-brand-earth-dark text-xl">Flexibla Platser</span>
                    </div>
                    <div class="text-neutral-700 leading-relaxed text-sm md:text-base flex-grow">
                        Vi genomför våra tjänster där det passar er bäst. På er arbetsplats eller i våra lokaler i <a href="/for-foretag/kontakt-offert/#mottagningar"
                            class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Nyköping</a>, <a href="/for-foretag/kontakt-offert/#mottagningar"
                            class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Gnesta</a> och <a href="/kontakt/#mottagningar"
                            class="text-brand-sky hover:text-brand-sky-dark font-medium underline decoration-brand-sky/20 underline-offset-4">Oxelösund</a>.
                    </div>
                </div>

                <!-- Column 2: Trygghet -->
                <div
                    class="group bg-brand-earth-dark/5 rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border-2 border-brand-earth-dark/10 flex flex-col items-start text-left">
                    <div class="flex items-center mb-4">
                        <div
                            class="flex items-center justify-center h-10 w-10 rounded-full bg-brand-earth-dark/25 text-brand-accent mr-3">
                            <Icon name="shield_health" class="h-6 w-6" />
                        </div>
                        <span class="font-bold text-brand-earth-dark text-xl">Resiliens</span>
                    </div>
                    <div class="text-neutral-700 leading-relaxed text-sm md:text-base flex-grow">
                        Att investera i personalens hälsa bygger starkare, mer resilienta och produktiva arbetsgrupper.<br />
                    </div>
                </div>

            </div>
        </div>
    </section>
</BaseLayout>
