---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/hero_ryggont8.png';
import tuinaManImage from '../../../assets/images/tuina_man.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'TuiNa-massage är mycket effektivt för att manuellt lösa upp de djupt liggande muskelspänningar i säte och ländrygg som ofta är den fysiska orsaken till trycket på nerven (s.k. falsk ischias).',
        image: tuinaManImage,
        alt: 'TuiNa-massage för att lösa djupliggande muskelspänningar vid ischias',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur är ett kraftfullt verktyg för att stimulera kroppens energisystem, minska inflammation och minska den utstrålande smärtan.',
        image: acupunctureImage,
        alt: 'Akupunktur vid ischias och utstrålande smärta',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    }
];

const faqs = [
    {
        question: 'Finns olika typer av ischias?',
        answer: `Ischiassmärtan kan bero på att ischiasnervens rot är i kläm av en skadad disk i ryggen 
        men kan också bero på nedsatt cirkulation, tryck eller skada närmare höft och ben.
        Vi har hjälpt många klienter med olika typer av ischias.`
    },
    {
        question: 'Kan behandlingen göra det värre i början?',
        answer: `Efter en djupgående behandling kan du uppleva en tillfällig "återhämtningsvärk" eller ömhet i musklerna likt träningsvärk, vilket är normalt. Själva nervsmärtan brukar dock inte förvärras. 
        Vi för alltid en noggrann dialog med dig för att säkerställa att behandlingen är trygg och anpassad efter din reaktion.`
    },
    {
        question: 'Vad kan jag göra själv för att förebygga att det händer igen?',
        answer: `När vi har minskat det akuta trycket 
        och smärtan är det viktigt att du stärker muskulaturen och förbättrar din hållning. 
        Regelbunden praktik av Tai Chi och Qigong är utmärkta verktyg för att bygga en stark, 
        balanserad och stabil grund på lång sikt.`
    }
];
---

<BaseLayout title="Behandling vid Ischiasbesvär & Smärta i Benet i Nyköping | Medidraken">
    
    <SymptomHero
        title="Ischias & Utstrålande Smärta"
        subtitle="Minska Smärta & Förbättra Rörligheten"
        image={heroImage}
        imageAlt="Ischias Behandling"
        buttonText="Behandla ischias"
        buttonLink="/kontakt"
    >
        Ischiassmärta, som ofta strålar från ländryggen och ilar genom skinka, 
        höft och ner i benet, kan vara både intensiv och oerhört begränsande.
        
        Längre stillasittande, plötsliga, tunga, felaktiga belastningar och stress är ofta orsaker
        till att smärtan uppstår.

        Genom kinesisk medicinsk behandling fokuserar vi på att mjuka upp spänningar i säte och ländrygg 
        för att minska trycket på ischiasnerven så att du får goda förutsättningar för 
        minskad smärta och förbättrad rörlighet.
    </SymptomHero>

    <SymptomMethods
        title="Hur vi Behandlar Ischias & Utstrålande Smärta"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Ischiassmärta orsakas ofta av ett tryck eller en inflammation runt nerven i ländrygg eller säte.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-6">
            Vi erbjuder två kompletterande metoder för att adressera både symtomet och den bakomliggande orsaken. De kan användas var för sig eller i kombination.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            Hör av dig så hittar vi tillsammans det upplägg som passar dig bäst.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Få hjälp med din ischias"
        ctaButtonText="Hör av dig och boka behandling"
        ctaSubject="ischias"
    >
        <p>
            Vi hjälper dig hitta rätt behandling för din ischiassmärta. 
            Många upplever en märkbar skillnad i smärta och rörlighet inom 3 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Behandling vid Ischiasbesvär"
        faqs={faqs}
    />

</BaseLayout>
