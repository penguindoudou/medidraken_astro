---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

// Images
import heroImage from '../../assets/images/taichi_in_a_circle_instructor_johannes_teaching_several_white_crane_spreading_its_wings_grass_sunny_weather.jpg';
import { siteConfig } from '../../data/site.ts';
---

<BaseLayout title="Begär Offert för Företagsfriskvård | Skräddarsydda Lösningar | Medidraken">
    <!-- Sektion 1: Hero -->
    <section class="hero-section">
        <div class="hero-background">
            <Image src={heroImage} alt="Begär Offert för Företagsfriskvård" class="hero-bg-image opacity-80" />
        </div>
        <div class="hero-content text-center">
            <div class="hero-text bg-brand-earth-dark/80 p-4 md:p-6 rounded-lg backdrop-blur-sm border border-white/10 md:max-w-5xl mx-auto">
                <h1 class="hero-title text-brand-accent">Begär en Skräddarsydd Offert</h1>

                <div class="text-lg text-neutral-100 leading-relaxed mt-0">
                    <p class="hero-text mt-3 md:mt-5 text-white/95">
                        Vi ser fram emot att höra mer om era behov och hur vi kan hjälpa er att skapa en friskare och mer välmående arbetsplats. Fyll i formuläret nedan med så mycket information som möjligt, så återkommer vi till er inom kort med ett personligt förslag och en offert.
                    </p>
                    
                    <h3 class="font-semibold text-xl mt-6 text-brand-accent-light">Föredrar du att bolla idéer direkt?</h3>
                    <p class="hero-text mt-2 md:mt-3">
                        Inga problem! Ring oss gärna på <a href={`tel:${siteConfig.phone.clean}`} class="text-brand-accent-light hover:text-brand-sky-bright font-normal underline decoration-brand-accent-light/30 underline-offset-4 transition-colors duration-200">{siteConfig.phone.display}</a> så kan vi tillsammans diskutera ett passande upplägg för just er.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Formulärsektion -->
    <section class="pb-20 pt-16 lg:pb-28 lg:pt-20 bg-brand-earth-lightest relative overflow-hidden">
        <div class="container-base max-w-4xl">
            <div class="contact-form-wrapper bg-white shadow-xl shadow-brand-earth/5 p-8 sm:p-10 rounded-2xl border border-brand-earth-light/30">
                <h2 class="text-2xl md:text-3xl font-heading text-brand-earth-dark mb-8 font-semibold border-b border-brand-earth-light/30 pb-4">Offertförfrågan</h2>

                <form action="#" method="POST" class="space-y-8"
                    x-data="{ 
                        locationType: 'hos_er',
                        companyName: '',
                        contactPerson: '',
                        email: '',
                        phone: '',
                        participants: '',
                        period: '',
                        address: '',
                        clinic: '',
                        message: ''
                    }">
                    
                    <!-- Kontaktuppgifter -->
                    <div class="space-y-5">
                        <h3 class="text-xl font-bold text-brand-earth-dark flex items-center">
                            <Icon name="user" class="w-6 h-6 mr-3 text-brand-accent-dark" />
                            Kontaktuppgifter
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label for="companyName" class="block text-sm font-medium text-neutral-700 mb-1">Företagsnamn <span class="text-red-500">*</span></label>
                                <input type="text" id="companyName" name="companyName" x-model="companyName" required
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50">
                            </div>
                            <div>
                                <label for="contactPerson" class="block text-sm font-medium text-neutral-700 mb-1">Kontaktperson (Ditt namn) <span class="text-red-500">*</span></label>
                                <input type="text" id="contactPerson" name="contactPerson" x-model="contactPerson" required
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label for="email" class="block text-sm font-medium text-neutral-700 mb-1">E-post <span class="text-red-500">*</span></label>
                                <input type="email" id="email" name="email" x-model="email" required
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50">
                            </div>
                            <div>
                                <label for="phone" class="block text-sm font-medium text-neutral-700 mb-1">Telefon <span class="text-red-500">*</span></label>
                                <input type="tel" id="phone" name="phone" x-model="phone" required
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50">
                            </div>
                        </div>
                    </div>

                    <!-- Tjänster -->
                    <div class="space-y-5 border-t border-brand-earth-light/30 pt-8">
                        <h3 class="text-xl font-bold text-brand-earth-dark flex items-center">
                            <Icon name="check-circle" class="w-6 h-6 mr-3 text-brand-accent-dark" />
                            Vilka tjänster är ni intresserade av?
                        </h3>
                        <p class="text-sm text-neutral-600 mb-4">Välj en eller flera tjänster som ni vill att offerten ska omfatta.</p>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <!-- Hälsa på Arbetsplatsen -->
                            <div class="bg-brand-sky-light/5 p-4 rounded-xl border border-brand-sky/10">
                                <h4 class="font-bold text-brand-earth-dark mb-3 text-sm uppercase tracking-wider">Hälsa på Arbetsplatsen</h4>
                                <div class="space-y-2">
                                    <label class="flex items-start cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Regelbundna klasser: Tai Chi & Qigong" class="mt-1 w-4 h-4 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                        <span class="ml-2 text-sm text-neutral-700 group-hover:text-brand-earth-dark transition-colors">Regelbundna klasser: Tai Chi & Qigong</span>
                                    </label>
                                    <label class="flex items-start cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Regelbundna Behandlingar" class="mt-1 w-4 h-4 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                        <span class="ml-2 text-sm text-neutral-700 group-hover:text-brand-earth-dark transition-colors">Regelbundna Behandlingar</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Företagsevent & Aktiviteter -->
                            <div class="bg-brand-sky-light/5 p-4 rounded-xl border border-brand-sky/10">
                                <h4 class="font-bold text-brand-earth-dark mb-3 text-sm uppercase tracking-wider">Företagsevent & Aktiviteter</h4>
                                <div class="space-y-2">
                                    <label class="flex items-start cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Föreläsning eller Workshop" class="mt-1 w-4 h-4 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                        <span class="ml-2 text-sm text-neutral-700 group-hover:text-brand-earth-dark transition-colors">Föreläsning eller Workshop</span>
                                    </label>
                                    <label class="flex items-start cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Uppvisning eller Prova-på" class="mt-1 w-4 h-4 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                        <span class="ml-2 text-sm text-neutral-700 group-hover:text-brand-earth-dark transition-colors">Uppvisning eller Prova-på</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Utbildning & Samarbeten -->
                            <div class="bg-brand-sky-light/5 p-4 rounded-xl border border-brand-sky/10">
                                <h4 class="font-bold text-brand-earth-dark mb-3 text-sm uppercase tracking-wider">Utbildning & Samarbeten</h4>
                                <div class="space-y-2">
                                    <label class="flex items-start cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Instruktörsutbildning för personal" class="mt-1 w-4 h-4 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                        <span class="ml-2 text-sm text-neutral-700 group-hover:text-brand-earth-dark transition-colors">Instruktörsutbildning för personal</span>
                                    </label>
                                    <label class="flex items-start cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Samarbete med hälsoanläggning/gym/spa" class="mt-1 w-4 h-4 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                        <span class="ml-2 text-sm text-neutral-700 group-hover:text-brand-earth-dark transition-colors">Samarbete med hälsoanläggning/gym/spa</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Annat -->
                            <div class="bg-brand-sky-light/5 p-4 rounded-xl border border-brand-sky/10">
                                <h4 class="font-bold text-brand-earth-dark mb-3 text-sm uppercase tracking-wider">Annat</h4>
                                <div class="space-y-2">
                                    <label class="flex items-start cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Annat / Jag är osäker" class="mt-1 w-4 h-4 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                        <span class="ml-2 text-sm text-neutral-700 group-hover:text-brand-earth-dark transition-colors">Annat / Jag är osäker</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Deltaljer & Ort -->
                    <div class="space-y-5 border-t border-brand-earth-light/30 pt-8">
                        <h3 class="text-xl font-bold text-brand-earth-dark flex items-center">
                            <Icon name="calendar" class="w-6 h-6 mr-3 text-brand-accent-dark" />
                            Detaljer & Genomförande
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label for="participants" class="block text-sm font-medium text-neutral-700 mb-1">Antal Deltagare (ungefärligt)</label>
                                <input type="number" id="participants" name="participants" x-model="participants" min="1"
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50"
                                    placeholder="T.ex. 15">
                            </div>
                            <div>
                                <label for="period" class="block text-sm font-medium text-neutral-700 mb-1">Önskad Period / Datum</label>
                                <input type="text" id="period" name="period" x-model="period"
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50"
                                    placeholder="T.ex. Hösten 2026 eller vecka 42">
                            </div>
                        </div>

                        <!-- Plats för Genomförande -->
                        <div class="mt-6">
                            <label class="block text-sm font-medium text-neutral-700 mb-2">Plats för Genomförande <span class="text-red-500">*</span></label>
                            
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <label class="relative flex items-center p-4 rounded-xl border cursor-pointer transition-all duration-200"
                                    :class="locationType === 'hos_er' ? 'bg-brand-sky-light/10 border-brand-sky ring-1 ring-brand-sky shadow-sm' : 'bg-white border-neutral-200 hover:bg-neutral-50'">
                                    <input type="radio" name="locationType" value="hos_er" x-model="locationType" class="sr-only">
                                    <div class="flex items-center">
                                        <div class="w-10 h-10 rounded-full flex items-center justify-center mr-3"
                                            :class="locationType === 'hos_er' ? 'bg-brand-sky text-white' : 'bg-neutral-100 text-neutral-500'">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                                        </div>
                                        <div>
                                            <div class="font-bold text-brand-earth-dark">Hos er</div>
                                            <div class="text-xs text-neutral-500 mt-0.5">På er arbetsplats eller annan plats</div>
                                        </div>
                                    </div>
                                    <template x-if="locationType === 'hos_er'">
                                        <svg class="w-5 h-5 ml-auto text-brand-sky" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                                    </template>
                                </label>

                                <label class="relative flex items-center p-4 rounded-xl border cursor-pointer transition-all duration-200"
                                    :class="locationType === 'hos_oss' ? 'bg-brand-sky-light/10 border-brand-sky ring-1 ring-brand-sky shadow-sm' : 'bg-white border-neutral-200 hover:bg-neutral-50'">
                                    <input type="radio" name="locationType" value="hos_oss" x-model="locationType" class="sr-only">
                                    <div class="flex items-center">
                                        <div class="w-10 h-10 rounded-full flex items-center justify-center mr-3"
                                            :class="locationType === 'hos_oss' ? 'bg-brand-sky text-white' : 'bg-neutral-100 text-neutral-500'">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                                        </div>
                                        <div>
                                            <div class="font-bold text-brand-earth-dark">Hos oss</div>
                                            <div class="text-xs text-neutral-500 mt-0.5">I Medidrakens lokaler</div>
                                        </div>
                                    </div>
                                    <template x-if="locationType === 'hos_oss'">
                                        <svg class="w-5 h-5 ml-auto text-brand-sky" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                                    </template>
                                </label>
                            </div>

                            <!-- Adressfält (Hos er) -->
                            <div x-show="locationType === 'hos_er'" x-cloak class="mt-4 bg-brand-accent/5 p-5 rounded-xl border border-brand-accent/20" x-transition>
                                <label for="address" class="block text-sm font-medium text-brand-earth-dark mb-1">C/O eller Adress (vid behov)</label>
                                <input type="text" id="address" name="address" x-model="address"
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-white">
                                <p class="text-xs text-neutral-500 mt-2">Fyll i om ni önskar en offert för tjänster som levereras hos er, för att vi ska kunna beräkna eventuella resekostnader.</p>
                            </div>

                            <!-- Välj mottagning (Hos oss) -->
                            <div x-show="locationType === 'hos_oss'" x-cloak class="mt-4 bg-brand-accent/5 p-5 rounded-xl border border-brand-accent/20" x-transition>
                                <label for="clinic" class="block text-sm font-medium text-brand-earth-dark mb-1">Välj mottagning</label>
                                <select id="clinic" name="clinic" x-model="clinic"
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-white">
                                    <option value="">-- Välj ort --</option>
                                    <option value="nykoping">Nyköping</option>
                                    <option value="gnesta">Gnesta</option>
                                    <option value="oxelosund">Oxelösund</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Meddelande -->
                    <div class="space-y-4 border-t border-brand-earth-light/30 pt-8">
                        <div>
                            <label for="message" class="block text-sm font-medium text-neutral-700 mb-1">Ditt Meddelande <span class="text-red-500">*</span></label>
                            <p class="text-xs text-neutral-500 mb-2">Beskriv gärna era önskemål, syftet med aktiviteten och annan information som kan vara relevant för oss.</p>
                            <textarea id="message" name="message" x-model="message" rows="5" required
                                class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50"></textarea>
                        </div>
                    </div>

                    <button type="submit" class="w-full btn btn-primary-on-dark mt-8 text-center justify-center py-4 text-lg">
                        Skicka Offertförfrågan
                    </button>
                </form>
            </div>
        </div>
    </section>
</BaseLayout>
