---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/hero_huvudvark2.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';
import tuinaImage from '../../../assets/images/tuina_head_woman.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'TuiNa-massage används för att lösa upp muskelspänningar i nacke, axlar, bröstrygg och käkar. Det hjälper musklerna och nervsystemet att slappna av, vilket förbättrar cirkulationen och ger goda förutsättningar för minskad huvudvärk.',
        image: tuinaImage,
        alt: 'TuiNa-massage för att lösa upp spänningar i nacke och axlar',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur används för att reglera energi- och nervsystemet. Det hjälper musklerna och nervsystemet att slappna av, vilket förbättrar cirkulationen och ger goda förutsättningar för minskad huvudvärk.',
        image: acupunctureImage,
        alt: 'Akupunktur för att behandla stress och spänningshuvudvärk',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    }
];

const faqs = [
    {
        question: 'Hur många behandlingar behövs för att bli fri från spänningshuvudvärk?',
        answer: 'Eftersom alla är olika kan vi inte garantera ett visst resultat inom ett specifikt antal behandlingar. Många upplever en påbörjad förbättring inom 3 behandlingar. Vid långvarig spänningshuvudvärk behövs ofta fler behandlingar och livsstilsförändringar för att uppnå varaktiga resultat.'
    },
    {
        question: 'Kan stress och ett stillasittande jobb leda till spänningshuvudvärk?',
        answer: 'Absolut. En statisk arbetsställning framför en skärm, särskilt i kombination med mental stress och ytlig andning, är den vanligaste orsaken till att musklerna i nacke, bröst och axlar blir kroniskt spända och utlöser huvudvärken.'
    },
    {
        question: 'Gör massagen ont när musklerna är så stela?',
        answer: 'TuiNa är en kraftfull och djupgående massage. Det kan kännas ordentligt när vi arbetar med stela muskler, en typ av "skön-ont" känsla. Vi anpassar dock alltid trycket efter din kropps förutsättningar och ser till att behandlingen känns okej, inte plågsam.'
    }
];
---

<BaseLayout 
    title="Behandling av Spänningshuvudvärk & Stresshuvudvärk | Medidraken"
    description="Få hjälp med din spänningshuvudvärk. Vi arbetar med akupunktur & TuiNa-massage för att lösa upp spänningar i nacke och käkar samt reducera stress."
>
    
    <SymptomHero
        title="Låt Oss Hjälpa Dig Med Din Spänningshuvudvärk"
        subtitle="Behandling för Nacke, Axlar och Huvud"
        image={heroImage}
        imageAlt="Behandling av spänningshuvudvärk och stresshuvudvärk"
        buttonText="Behandla Spänningshuvudvärk"
        buttonLink="/kontakt"
    >
        Upplever du en molande värk som ett trångt band runt huvudet? 
        </br>
        Spänningshuvudvärk, även kallat stresshuvudvärk, orsakas ofta av ihållande muskelspänningar i nacke, axlar och käkar som byggts upp av stress och statiskt arbete. 
        Vi hjälper dig att lösa upp spänningarna, reglera nervsystemet så att din kropp får bättre förutsättningar för minskad smärta.
    </SymptomHero>

    <SymptomMethods
        title="Hur vi Behandlar Spänningshuvudvärk"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            För att mjuka upp de inre spänningarna och balansera det känsliga nervsystemet erbjuder vi två kompletterande metoder.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            De kan användas var för sig eller i kombination för att ge kroppen bättre förutsättningar att minska både antalet migränanfall och hur kraftfulla de blir.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            Hör av dig så hittar vi tillsammans det upplägg som passar dig bäst.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Få Hjälp Med Din Huvudvärk"
        ctaButtonText="Hör av Dig & Boka behandling"
        ctaSubject="spanningshuvudvark"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Huvudvärk dränerar kroppen på energi. Låt oss hjälpa dig att släppa spänningarna. Många upplever minskad huvudvärk inom 3 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Spänningshuvudvärk"
        faqs={faqs}
    />

</BaseLayout>
