---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethodsThreeCol from '../../../components/symptom/SymptomMethodsThreeCol.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/hoftbesvar_hoftsmarta_hero.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';
import tuinaManImage from '../../../assets/images/tuina_girl_wide2.png';
import taichiImage from '../../../assets/images/taichi_hero6.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'TuiNa används för att lösa upp spänningar i de stora muskelgrupperna runt höften, ländryggen och sätet som nästan alltid är involverade i höftbesvär.',
        image: tuinaManImage,
        alt: 'TuiNa-massage mjukar upp muskelspänningar och stimulerar cirkulationen runt höften',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur används för att reglera de energibanor som löper genom höften och sätesmuskulaturen.',
        image: acupunctureImage,
        alt: 'Akupunktur mot höftsmärta och inflammation',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    },
    {
        title: 'Tai Chi & Qigong',
        desc: 'Tai Chi och Medicinsk Qigong hjälper till att stärka de muskler som stöttar upp höften och därmed bidra till minskad smärta och förbättrad funktion.',
        image: taichiImage,
        alt: 'Skonsam träning för starkare höfter med Tai Chi och Qigong',
        url: '/kurser',
        linkText: '→ Läs mer om vår träning',
        theme: 'accent' as const
    }
];

const faqs = [
    {
        question: 'Jag har fått diagnosen höftartros, kan jag ändå få hjälp?',
        answer: 'Absolut. Även om vi inte kan bota själva artrosen, är våra metoder mycket effektiva för stärka och förbättra funktionen av musklerna runt höften och därmed skapa förutsättningar för minskad smärta, ökad rörlighet och bättre funktion i vardagen.'
    },
    {
        question: 'Min smärta sitter mest i sätet/skinkan, är det verkligen höften?',
        answer: 'Det är mycket vanligt. Smärta i sätet kan komma från höftleden, men den kan också komma från spända muskler (falsk ischias) eller från ländryggen. Vi har hjälpt många patienter med smärta i olika områden runt höften.'
    },
    {
        question: 'Är det inte bättre att vila helt när jag har ont i höften?',
        answer: 'Det beror på orsaken, men ofta är skonsam och anpassad rörelse bättre än total vila. Rörelse stimulerar cirkulation och "smörjer" leden. Vi ger dig råd om vilken typ av aktivitet som är lämplig under behandlingsperioden.'
    },
    {
        question: 'Vad kan jag göra själv för att få ett bättre resultat?',
        answer: 'Din delaktighet är viktig för bästa resultat. Medan vi fokuserar på att minska din smärta genom behandling, rekommenderar vi regelbunden skonsam rörelse. Att praktisera Tai Chi eller Medicinsk Qigong regelbundet är ett utmärkt sätt att själv bygga en stark och smidig muskulatur runt höften på sikt.'
    }
];
---

<BaseLayout title="Behandling av Ont i Höften & Höftartros i Nyköping | Medidraken">
    
    <SymptomHero
        title="Ont i Höft & Höftbesvär"
        subtitle="Minska Smärta & Förbättra Funktion"
        image={heroImage}
        imageAlt="Behandling av höftbesvär"
        buttonText="Behandla Höftbesvär"
        buttonLink="/kontakt"
    >
        Smärt och stelhet i höften, sätet eller ljumsken kan göra allt från att gå till att sova besvärligt. 
        Ofta beror det på överbelastning, muskelsvaghet eller höftledsartros. 
        Med TCM-behandling och träning kan vi hjälpa dig att mjuka upp muskelspänningar och stärka musklerna kring höften 
        för att ge goda förutsättningar för minskad smärta och förbättrad rörlighet och funktion i vardagen.
    </SymptomHero>

    <SymptomMethodsThreeCol
        title="Minska Smärta & Förbättra Funktion"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Oavsett om din smärta sitter i sätet, ljumsken eller själva höften hjälper vi dig att hitta rätt behandling för just dig och din kropp.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            För att ge kroppen goda förutsättningar för minskad smärta och förbättrad funktion 
            erbjuder vi både behandlingar och skonsam stärkande träning. 
            Hör av dig så hittar vi tillsammans ett upplägg som passar dig bäst.
        </p>
    </SymptomMethodsThreeCol>

    <SymptomCTA
        title="Få Hjälp Med Din Höftbesvär"
        ctaButtonText="Hör av Dig & Boka Behandling"
        ctaSubject="hoftbesvar"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Vi hjälper dig hitta rätt behandling för dina höfter. 
            Att bli helt fri från sina höftbesvär är inte alltid möjligt. 
             
            Många börjar dock uppleva en minskning i
            smärta och en mjukare, 
            rörligare känsla inom 5 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Behandling av Höftsmärta"
        faqs={faqs}
    />

</BaseLayout>
