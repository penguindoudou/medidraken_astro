---
export const prerender = false;

import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

// Images
import heroImage from '../../assets/images/taichi_in_a_circle_instructor_johannes_teaching_several_white_crane_spreading_its_wings_grass_sunny_weather.jpg';
import { siteConfig } from '../../data/site.ts';

let formStatus = Astro.url.searchParams.get('skickat') === '1' ? 'success' : '';

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    
    if (data.get("website")) {
      return Astro.redirect('/for-foretag/kontakt-offert?skickat=1', 302);
    }

    // Get env vars with fallback for Cloudflare runtime
    let botToken = import.meta.env.TELEGRAM_BOT_TOKEN || process.env.TELEGRAM_BOT_TOKEN || (Astro.locals as any).runtime?.env?.TELEGRAM_BOT_TOKEN;
    const chatId = import.meta.env.TELEGRAM_CHAT_ID || process.env.TELEGRAM_CHAT_ID || (Astro.locals as any).runtime?.env?.TELEGRAM_CHAT_ID;
    
    // Clean token (remove 'bot' prefix if user accidentally included it, remove quotes/spaces)
    if (botToken) {
      botToken = botToken.trim().replace(/^['"]|['"]$/g, '').replace(/^bot/i, '');
    }

    // Helper to escape HTML special chars for Telegram HTML parse mode
    const esc = (s: unknown) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    // Timestamp
    const now = new Date();
    const timestamp = now.toLocaleString('sv-SE', { timeZone: 'Europe/Stockholm', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });

    // Clinic slug → display name
    const clinicMap: Record<string, string> = {
      'gnesta': 'Gnesta',
      'nykoping': 'Nyköping',
      'oxelosund': 'Oxelösund',
    };

    let text = `💼 <b>Ny Offertförfrågan (Företag)</b>  <i>${esc(timestamp)}</i>\n`;
    text += `━━━━━━━━━━━━━━━━━━\n`;
    text += `🏢 <b>Kontaktuppgifter</b>\n`;
    text += `<b>Företag:</b> ${esc(data.get("companyName") || "–")}\n`;
    text += `<b>Kontaktperson:</b> ${esc(data.get("contactPerson") || "–")}\n`;
    text += `<b>E-post:</b> ${esc(data.get("email") || "–")}\n`;
    text += `<b>Telefon:</b> ${esc(data.get("phone") || "–")}\n`;

    text += `\n━━━━━━━━━━━━━━━━━━\n`;
    text += `🎯 <b>Önskade Tjänster</b>\n`;

    const services = data.getAll("services[]") as string[];
    if (services.length > 0) {
      const groups = [
        { parent: "Friskvård på Arbetsplatsen", subs: ["Medicinsk Qigong & Tai Chi", "Behandlingar på Plats"] },
        { parent: "Event & Aktivitet", subs: ["Workshop: Introduktion till Stresshantering", "Uppvisning & Prova-på"] },
        { parent: "Samarbeten", subs: ["Samarbete: Boka Kurser", "Samarbete: Boka Behandlingar", "Samarbete: Boka Instruktörsutbildning"] },
        { parent: "Specialförfrågan", subs: [] }
      ];

      groups.forEach(group => {
        const hasParent = services.includes(group.parent);
        const selectedSubs = group.subs.filter(s => services.includes(s));
        if (hasParent || selectedSubs.length > 0) {
          text += `▸ <b>${esc(group.parent)}</b>\n`;
          selectedSubs.forEach(sub => text += `  – ${esc(sub)}\n`);
        }
      });
    } else {
      text += `<i>Inga tjänster valda</i>\n`;
    }

    const specialRequest = data.get("specialRequest");
    if (specialRequest && services.includes("Specialförfrågan")) {
      text += `<b>Specialförfrågan detaljer:</b> ${esc(specialRequest)}\n`;
    }

    text += `\n━━━━━━━━━━━━━━━━━━\n`;
    text += `📋 <b>Detaljer & Genomförande</b>\n`;

    const participants = data.get("participants");
    const period = data.get("period");
    const sessions = data.get("sessions");
    const budget = data.get("budget");

    if (participants) text += `<b>Deltagare:</b> ${esc(participants)}\n`;
    if (period) text += `<b>Önskad period:</b> ${esc(period)}\n`;
    if (sessions) text += `<b>Omfattning:</b> ${esc(sessions)}\n`;
    if (budget) text += `<b>Budget:</b> ${esc(budget)}\n`;

    if (!participants && !period && !sessions && !budget) {
      text += `<i>Inga detaljer angivna</i>\n`;
    }

    text += `\n━━━━━━━━━━━━━━━━━━\n`;
    text += `📍 <b>Plats för Genomförande</b>\n`;

    const locationType = data.get("locationType");
    if (locationType === 'hos_er') {
      text += `<b>Plats:</b> Hos företaget\n`;
      const address = data.get("address");
      if (address) text += `<b>Adress:</b> ${esc(address)}\n`;
    } else {
      text += `<b>Plats:</b> Hos Medidraken\n`;
      const clinic = data.get("clinic") as string | null;
      if (clinic) text += `<b>Mottagning:</b> ${esc(clinicMap[clinic] || clinic)}\n`;
    }

    const message = data.get("message");
    if (message) {
      text += `\n━━━━━━━━━━━━━━━━━━\n`;
      text += `💬 <b>Meddelande</b>\n${esc(message)}`;
    }

    // Telegram HTML mode limit is 4096. Truncate to 4000 to be safe.
    if (text.length > 4000) {
      text = text.substring(0, 4000) + '... [Klippt]';
    }

    if (botToken && chatId) {
       const response = await fetch(`https://api.telegram.org/bot${botToken}/sendMessage`, {
         method: 'POST',
         headers: { 'Content-Type': 'application/json' },
         body: JSON.stringify({ chat_id: chatId, text: text, parse_mode: 'HTML' })
       });
       if (response.ok) {
         return Astro.redirect('/for-foretag/kontakt-offert?skickat=1', 302);
       } else {
         formStatus = 'error';
         console.error("Telegram API Error:", await response.text());
       }
    } else {
      console.error("Missing telegram credentials");
      formStatus = 'error';
    }
  } catch (e) {
    console.error("Form processing error:", e);
    formStatus = 'error';
  }
}
---

<BaseLayout title="Begär Offert för Företagsfriskvård | Skräddarsydda Lösningar | Medidraken"
  description="Begär offert för företagsfriskvård, events eller samarbeten i Nyköping. Vi skräddarsyr lösningar utifrån era behov och mål.">
    <!-- Sektion 1: Hero -->
    <section class="hero-section">
        <div class="hero-background">
            <Image src={heroImage} alt="Begär Offert för Företagsfriskvård" class="hero-bg-image opacity-80" />
        </div>
        <div class="hero-content text-center">
            <div class="hero-text bg-brand-earth-dark/80 p-4 md:p-6 rounded-lg backdrop-blur-sm border border-white/10 md:max-w-5xl mx-auto">
                <h1 class="hero-title text-brand-accent">Boka Företagstjänster & Offert</h1>

                <div class="text-lg text-neutral-100 leading-relaxed mt-0">
                    <h2 class="hero-subtitle font-semibold">Vi ser fram emot att höra från er!</h2>
                    <p class="hero-text mt-2 text-white/95">
                        Berätta vad ni är intresserade av så återkommer vi med ett förslag som passar just er verksamhet.
                    </p>
                    
                    <h3 class="font-semibold text-xl mt-6 text-brand-accent-light">Föredrar du att bolla idéer direkt?</h3>
                    <p class="hero-text mt-2 md:mt-3">
                        Ring oss gärna på <a href={`tel:${siteConfig.phones.johannes.clean}`} class="text-brand-accent-light hover:text-brand-sky-bright font-normal underline decoration-brand-accent-light/30 underline-offset-4 transition-colors duration-200">{siteConfig.phones.johannes.display}</a>.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Formulärsektion -->
    <section class="pb-20 pt-16 lg:pb-28 lg:pt-20 bg-brand-earth-lightest relative overflow-hidden">
        <div class="container-base max-w-4xl">
            <div class="contact-form-wrapper bg-white shadow-xl shadow-brand-earth/5 p-8 sm:p-10 rounded-2xl border border-brand-earth-light/30">
                <h2 class="text-2xl md:text-3xl font-heading text-brand-earth-dark mb-8 font-semibold border-b border-brand-earth-light/30 pb-4">Kontakt & Förfrågan</h2>

                {formStatus === 'success' ? (
                    <div class="bg-brand-sky-light/10 border border-brand-sky/30 rounded-xl p-8 text-center">
                        <div class="w-16 h-16 bg-brand-sky/20 rounded-full flex items-center justify-center mx-auto mb-4 text-brand-sky-dark">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <h4 class="text-2xl font-bold text-brand-earth-dark mb-2">Tack för er förfrågan!</h4>
                        <p class="text-neutral-700">Vi har tagit emot er förfrågan och återkommer så snart vi kan.</p>
                        <a href="/for-foretag/kontakt-offert" class="mt-6 inline-block btn btn-primary-on-light">Skicka en till förfrågan</a>
                    </div>
                ) : (
                    <>
                        {formStatus === 'error' && (
                            <div class="bg-red-50 text-red-600 p-4 rounded-lg mb-6 border border-red-200">
                                Något gick fel när förfrågan skulle skickas. Vänligen försök igen eller kontakta oss via telefon eller e-post.
                            </div>
                        )}
                <form action="/for-foretag/kontakt-offert" method="POST" class="space-y-8"
                    x-data="{ 
                        locationType: 'hos_er',
                        companyName: '',
                        contactPerson: '',
                        email: '',
                        phone: '',
                        participants: '',
                        period: '',
                        sessions: 'Prova-på (1 tillfälle)',
                        budget: '',
                        address: '',
                        clinic: '',
                        message: '',
                        selectedServices: [],
                        init() {
                            const params = new URLSearchParams(window.location.search);
                            const type = params.get('type');
                            if (type === 'event') {
                                this.selectedServices.push('Event & Aktivitet');
                                const subtype = params.get('subtype');
                                if (subtype === 'workshop') {
                                    this.selectedServices.push('Workshop: Introduktion till Stresshantering');
                                } else if (subtype === 'uppvisning') {
                                    this.selectedServices.push('Uppvisning & Prova-på');
                                }
                            } else if (type === 'friskvard') {
                                this.selectedServices.push('Friskvård på Arbetsplatsen');
                                const subtype = params.get('subtype');
                                if (subtype === 'qigong') {
                                    this.selectedServices.push('Medicinsk Qigong & Tai Chi');
                                } else if (subtype === 'behandlingar') {
                                    this.selectedServices.push('Behandlingar på Plats');
                                }
                            } else if (type === 'samarbete') {
                                this.selectedServices.push('Samarbeten');
                                const subtype = params.get('subtype');
                                if (subtype === 'kurser') {
                                    this.selectedServices.push('Samarbete: Boka Kurser');
                                } else if (subtype === 'behandlingar') {
                                    this.selectedServices.push('Samarbete: Boka Behandlingar');
                                } else if (subtype === 'utbildning') {
                                    this.selectedServices.push('Samarbete: Boka Instruktörsutbildning');
                                }
                            }
                        }
                    }">
                    
                    <!-- Honeypot -->
                    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

                    <!-- Kontaktuppgifter -->
                    <div class="space-y-5">
                        <h3 class="text-xl font-bold text-brand-earth-dark flex items-center">
                            <Icon name="user" class="w-6 h-6 mr-3 text-brand-accent-dark" />
                            Kontaktuppgifter
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label for="companyName" class="block text-sm font-medium text-neutral-700 mb-1">Företagsnamn <span class="text-red-500">*</span></label>
                                <input type="text" id="companyName" name="companyName" x-model="companyName" required
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50">
                            </div>
                            <div>
                                <label for="contactPerson" class="block text-sm font-medium text-neutral-700 mb-1">Kontaktperson (Ditt namn) <span class="text-red-500">*</span></label>
                                <input type="text" id="contactPerson" name="contactPerson" x-model="contactPerson" required
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label for="email" class="block text-sm font-medium text-neutral-700 mb-1">E-post <span class="text-red-500">*</span></label>
                                <input type="email" id="email" name="email" x-model="email" required
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50">
                            </div>
                            <div>
                                <label for="phone" class="block text-sm font-medium text-neutral-700 mb-1">Telefon <span class="text-red-500">*</span></label>
                                <input type="tel" id="phone" name="phone" x-model="phone" required
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50">
                            </div>
                        </div>
                    </div>

                    <!-- Tjänster -->
                    <div class="space-y-5 border-t border-brand-earth-light/30 pt-8">
                        <h3 class="text-xl font-bold text-brand-earth-dark flex items-center">
                            <Icon name="check-circle" class="w-6 h-6 mr-3 text-brand-accent-dark" />
                            Vilka tjänster är ni intresserade av?
                        </h3>
                        <p class="text-sm text-neutral-600 mb-4">Välj en eller flera kategorier.</p>
                        
                        <div class="grid grid-cols-1 gap-6">
                            <!-- Friskvård för Personal -->
                            <div class="bg-brand-sky-light/5 p-5 rounded-xl border border-brand-sky/10 transition-all hover:border-brand-sky/30">
                                <label class="flex items-start cursor-pointer group">
                                    <input type="checkbox" name="services[]" value="Friskvård på Arbetsplatsen" x-model="selectedServices" class="mt-1 w-5 h-5 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                    <div class="ml-3">
                                        <span class="block font-bold text-brand-earth-dark group-hover:text-brand-sky transition-colors">Friskvård på Arbetsplatsen</span>
                                        <span class="text-xs text-neutral-500">Massage, Tai Chi-klasser eller behandlingar</span>
                                    </div>
                                </label>

                                <div x-show="selectedServices.includes('Friskvård på Arbetsplatsen')" x-cloak x-transition class="mt-4 ml-8 space-y-3 pt-3 border-l-2 border-brand-sky/20 pl-4">
                                    <label class="flex items-center cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Medicinsk Qigong & Tai Chi" x-model="selectedServices" class="w-4 h-4 text-brand-sky border-neutral-300 rounded">
                                        <span class="ml-2 text-sm text-neutral-700">Medicinsk Qigong & Tai Chi</span>
                                    </label>
                                    <label class="flex items-center cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Behandlingar på Plats" x-model="selectedServices" class="w-4 h-4 text-brand-sky border-neutral-300 rounded">
                                        <span class="ml-2 text-sm text-neutral-700">Behandlingar på Plats</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Event & Aktivitet -->
                            <div class="bg-brand-sky-light/5 p-5 rounded-xl border border-brand-sky/10 transition-all hover:border-brand-sky/30">
                                <label class="flex items-start cursor-pointer group">
                                    <input type="checkbox" name="services[]" value="Event & Aktivitet" x-model="selectedServices" class="mt-1 w-5 h-5 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                    <div class="ml-3">
                                        <span class="block font-bold text-brand-earth-dark group-hover:text-brand-sky transition-colors">Event & Aktivitet</span>
                                        <span class="text-xs text-neutral-500">Föreläsning, workshop eller uppvisning</span>
                                    </div>
                                </label>

                                <div x-show="selectedServices.includes('Event & Aktivitet')" x-cloak x-transition class="mt-4 ml-8 space-y-3 pt-3 border-l-2 border-brand-sky/20 pl-4">
                                    <label class="flex items-center cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Workshop: Introduktion till Stresshantering" x-model="selectedServices" class="w-4 h-4 text-brand-sky border-neutral-300 rounded">
                                        <span class="ml-2 text-sm text-neutral-700">Workshop: Introduktion till Stresshantering</span>
                                    </label>
                                    <label class="flex items-center cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Uppvisning & Prova-på" x-model="selectedServices" class="w-4 h-4 text-brand-sky border-neutral-300 rounded">
                                        <span class="ml-2 text-sm text-neutral-700">Uppvisning & Prova-på</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Samarbeten (Dynamic) -->
                            <div class="bg-brand-sky-light/5 p-5 rounded-xl border border-brand-sky/10 transition-all hover:border-brand-sky/30">
                                <label class="flex items-start cursor-pointer group">
                                    <input type="checkbox" name="services[]" value="Samarbeten" x-model="selectedServices" class="mt-1 w-5 h-5 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                    <div class="ml-3">
                                        <span class="block font-bold text-brand-earth-dark group-hover:text-brand-sky transition-colors">Samarbeten</span>
                                        <span class="text-xs text-neutral-500">För hälsoanläggningar, gym eller större projekt</span>
                                    </div>
                                </label>

                                <div x-show="selectedServices.includes('Samarbeten')" x-cloak x-transition class="mt-4 ml-8 space-y-3 pt-3 border-l-2 border-brand-sky/20 pl-4">
                                    <label class="flex items-center cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Samarbete: Boka Kurser" x-model="selectedServices" class="w-4 h-4 text-brand-sky border-neutral-300 rounded">
                                        <span class="ml-2 text-sm text-neutral-700">Boka Kurser (för gäster/kunder)</span>
                                    </label>
                                    <label class="flex items-center cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Samarbete: Boka Behandlingar" x-model="selectedServices" class="w-4 h-4 text-brand-sky border-neutral-300 rounded">
                                        <span class="ml-2 text-sm text-neutral-700">Boka Behandlingar (på er plats)</span>
                                    </label>
                                    <label class="flex items-center cursor-pointer group">
                                        <input type="checkbox" name="services[]" value="Samarbete: Boka Instruktörsutbildning" x-model="selectedServices" class="w-4 h-4 text-brand-sky border-neutral-300 rounded">
                                        <span class="ml-2 text-sm text-neutral-700">Boka Instruktörsutbildning (för personal)</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Specialförfrågan (Dynamic) -->
                            <div class="bg-brand-sky-light/5 p-5 rounded-xl border border-brand-sky/10 transition-all hover:border-brand-sky/30">
                                <label class="flex items-start cursor-pointer group">
                                    <input type="checkbox" name="services[]" value="Specialförfrågan" x-model="selectedServices" class="mt-1 w-5 h-5 text-brand-sky border-neutral-300 rounded focus:ring-brand-sky focus:ring-2">
                                    <div class="ml-3">
                                        <span class="block font-bold text-brand-earth-dark group-hover:text-brand-sky transition-colors">Specialförfrågan</span>
                                        <span class="text-xs text-neutral-500">Andra önskemål eller skräddarsydda behov</span>
                                    </div>
                                </label>

                                <div x-show="selectedServices.includes('Specialförfrågan')" x-cloak x-transition class="mt-4 pt-2">
                                    <textarea name="specialRequest" placeholder="Beskriv er specialförfrågan här..." class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-white text-sm" rows="3"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Deltaljer & Ort -->
                    <div class="space-y-5 border-t border-brand-earth-light/30 pt-8">
                        <h3 class="text-xl font-bold text-brand-earth-dark flex items-center">
                            <Icon name="calendar" class="w-6 h-6 mr-3 text-brand-accent-dark" />
                            Detaljer & Genomförande
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label for="participants" class="block text-sm font-medium text-neutral-700 mb-1">Antal Deltagare (ungefärligt)</label>
                                <input type="number" id="participants" name="participants" x-model="participants" min="1"
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50"
                                    placeholder="T.ex. 15">
                            </div>
                            <div>
                                <label for="period" class="block text-sm font-medium text-neutral-700 mb-1">Önskad Period / Startdatum</label>
                                <input type="text" id="period" name="period" x-model="period"
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50"
                                    placeholder="T.ex. Snarast eller vecka 42">
                            </div>
                        </div>

                         <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5">
                            <div>
                                <label for="sessions" class="block text-sm font-medium text-neutral-700 mb-1">Omfattning / Antal tillfällen</label>
                                <select id="sessions" name="sessions" x-model="sessions"
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50">
                                    <option value="Prova-på (1 tillfälle)">Prova-på (1 tillfälle)</option>
                                    <option value="Paket (5-10 tillfällen)">Paket (5-10 tillfällen)</option>
                                    <option value="Löpande / Terminsvis">Löpande / Terminsvis</option>
                                    <option value="Jag är osäker / Berätta mer">Jag är osäker / Berätta mer</option>
                                </select>
                            </div>
                            <div>
                                <label for="budget" class="block text-sm font-medium text-neutral-700 mb-1">Budget (valfritt)</label>
                                <select id="budget" name="budget" x-model="budget"
                                    class="w-full border-neutral-300 rounded-md shadow-sm focus:border-brand-sky focus:ring focus:ring-brand-sky/20 transition-all p-3 border bg-neutral-50/50">
                                    <option value="">-- Välj budget --</option>
                                    <option value="Under 10 000 kr">Under 10 000 kr</option>
                                    <option value="10 000 – 25 000 kr">10 000 – 25 000 kr</option>
                                    <option value="25 000 – 50 000 kr">25 000 – 50 000 kr</option>
                                    <option value="Över 50 000 kr">Över 50 000 kr</option>
