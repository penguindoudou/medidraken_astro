---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/armbagssmarta_hero3.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';
import tuinaManImage from '../../../assets/images/tuina_girl_wide2.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'TuiNa används för att lösa upp spänningar i underarmar, handleder och överarmar som är starkt bidragande till musarm och tennisarmbåge.',
        image: tuinaManImage,
        alt: 'TuiNa-massage mjukar upp muskelspänningar i underarmarna',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur är en effektiv metod för att stimulera blodcirkulationen och lugna inflammerade muskelfästen runt armbåge och handled. Det ger goda förutsättningar för minskad smärta och förbättrad rörlighet.',
        image: acupunctureImage,
        alt: 'Akupunktur mot tennisarmbåge och handledssmärta',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    }
];

const faqs = [
    {
        question: 'Jag har ont i armbågen när jag lyfter saker, är det tennisarmbåge?',
        answer: 'Det är mycket möjligt. Smärta på armbågens utsida när du lyfter, greppar något eller vrider ur en disktrasa är klassiska tecken på tennisarmbåge. Det är en överbelastningsskada som vi hjälpt många med.'
    },
    {
        question: 'Det värker på insidan av armbågen, vad kan det bero på?',
        answer: 'Smärta på armbågens insida kallas ofta för golfarmbåge. Trots namnet beror det oftast på upprepade lyft eller rörelser i vardagen, inte golf. Precis som tennisarmbåge är det en överbelastningsskada som vi hjälpt många med.'
    },
    {
        question: 'Hjälper akupunktur mot domningar ut i fingrarna (karpaltunnelsyndrom)?',
        answer: 'Ja, domningar i fingrarna beror ofta på att nerver kommer i kläm på grund av spända muskler i underarm eller nacke/axel. Akupunktur och TuiNa-massage hjälper till att släppa dessa muskelspänningar vilket ofta minskar domningarna.'
    },
    {
        question: 'Måste jag sluta jobba framför datorn om jag har musarm?',
        answer: 'Nej, men det är viktigt att anpassa din ergonomi och ta korta pauser. Vi kombinerar behandling med att ge dig ergonomiska råd och enkla övningar du kan göra under arbetsdagen för att minska arbetspåfrestningen.'
    },
    {
        question: 'Hur lång tid tar det att bli bra från en tennisarmbåge?',
        answer: 'Det varierar beroende på hur länge du haft besvären. Eftersom senfästen läker långsamt kan det ta tid, men med rätt behandling brukar man märka en påbörjad förbättring i smärta och funktion inom några behandlingstillfällen.'
    }
];
---

<BaseLayout title="Behandling av Tennisarmbåge, Musarm & Värk i Handleder i Nyköping | Medidraken"
  description="Bli av med smärta från tennisarmbåge, musarm eller stela handleder. Effektiv akupunktur och medicinsk massage i Nyköping & Gnesta.">
    
    <div class="hero-tennisarmbage">
        <SymptomHero
            title="Tennisarmbåge, Musarm & Värk i Handleder"
            subtitle="Minska Smärta & Förbättra Funktion"
            image={heroImage}
            imageAlt="Behandling av tennisarmbåge och handledsvärk"
            buttonText="Behandla Armbåge & Handled"
            buttonLink="/kontakt?subject=tennisarmbage-musarm"
        >
            Har du ont på utsidan av armbågen, domningar i fingrarna eller värk i handleden?
            Känns det obehagligt att vrida ur disktrasan?
            Tennisarmbåge, golfarmbåge och musarm beror ofta på ensidiga rörelser och överbelastning.
            Genom TCM-behandling kan vi hjälpa till att lösa upp underliggande muskelspänningar
            och påskynda kroppens egen läkning så du får goda förutsättningar till minskad smärta och fungerande armar och händer.
        </SymptomHero>
    </div>

    <SymptomMethods
        title="Hur vi Behandlar Tennisarmbåge, Musarm & Värk i Handlederna"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Värk i armbåge och handleder påverkar nästan allt vi gör, från att lyfta ett mjölkpaket till att arbeta framför datorn.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-6">
            Vi erbjuder kompletterande metoder för att minska den akuta smärtan vid senfästet och behandla de muskelspänningar i underarm och axel som ofta bidrar till problemet.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Få Hjälp Med Din Armbågs- eller Handledssmärta"
        ctaButtonText="Hör av Dig & Boka Behandling"
        ctaSubject="tennisarmbage-musarm"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Vi hjälper dig hitta rätt behandling för din värk.
             
            Många börjar uppleva en minskning i smärta och en mjukare, rörligare känsla inom 5 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Armbågs- & Handledsbesvär"
        faqs={faqs}
    />

</BaseLayout>

<style is:global>
  .hero-tennisarmbage .hero-bg-image {
    object-position: 50% 30% !important;
  }
</style>
