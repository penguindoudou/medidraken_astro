---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SymptomHero from '../../components/symptom/SymptomHero.astro';
import SymptomMethodsThreeCol from '../../components/symptom/SymptomMethodsThreeCol.astro';
import SymptomCTA from '../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../assets/images/hero_immune.png';
import treatmentImage from '../../assets/images/tuina_girl_wide2.png';
import qigongImage from '../../assets/images/qigong_johannes_instructing_group_all_facing_camera_on_green_grass_in_front_of_lake_murky_weather_white_sky_almost_white_looking_lake.jpg';
import taichiImage from '../../assets/images/taichi_in_a_circle_instructor_johannes_teaching_several_white_crane_spreading_its_wings_grass_sunny_weather.jpg';

const methods = [
    {
        title: 'Akupunktur & TuiNa-massage',
        desc: 'Stärkande behandlingar som optimerar kroppens funktioner och hjälper till att bygga upp din inre sköld, det vi inom traditionell kinesisk medicin kallar Wei Qi.',
        image: treatmentImage,
        alt: 'Behandling med Akupunktur och TuiNa-massage för starkare motståndskraft',
        url: '/behandling/',
        linkText: '→ Läs mer om våra behandlingar',
        theme: 'accent' as const
    },
    {
        title: 'Medicinsk Qigong',
        desc: 'Lugn medveten rörelse och andning för att fylla på kroppens energi och upprätthålla goda förutsättningar för optimal hälsa och vitalitet under årets alla årstider.',
        image: qigongImage,
        alt: 'Medicinsk Qigong för inre styrka och energi',
        url: '/kurser/medicinsk-qigong/',
        linkText: '→ Läs mer om Medicinsk Qigong',
        theme: 'sky' as const
    },
    {
        title: 'Tai Chi',
        desc: 'Regelbunden och fokuserad rörelse som stärker kroppen inifrån och ut, vilket skapar goda förutsättningar för optimal hälsa och vitalitet under årets alla årstider.',
        image: taichiImage,
        alt: 'Tai Chi för hälsa och vitalitet',
        url: '/kurser/tai-chi/',
        linkText: '→ Läs mer om Tai Chi',
        theme: 'accent' as const
    }
];

const faqs = [
    {
        question: 'Vad är Wei Qi och hur påverkar det min hälsa?',
        answer: 'Wei Qi är ett begrepp inom traditionell kinesisk medicin som kan liknas vid kroppens inre sköld eller immunförsvar. Det cirkulerar strax under huden och skyddar oss mot yttre påfrestningar. Genom våra behandlingar och träningsformer arbetar vi för att stärka din Wei Qi och därmed din naturliga motståndskraft.'
    },
    {
        question: 'Hur bygger jag upp mitt försvar långsiktigt?',
        answer: 'Att bygga en stark motståndskraft kräver kontinuitet. Både regelbundna, balanserande behandlingar som Akupunktur och TuiNa-massage, eller regelbunden stärkande träning som Tai Chi och Medicinsk Qigong, stödjer kroppen att hålla sig frisk och stark över tid.'
    },
    {
        question: 'Hur hjälper Tai Chi och Qigong mig att hålla mig frisk?',
        answer: 'De är utmärkta verktyg för att bygga upp kroppens inre motståndskraft. Regelbunden träning ökar din kroppsmedvetenhet, sänker grundstressen och ser till att energin flödar friare, vilket skapar en stabil grund för vitalitet och god hälsa.'
    },
    {
        question: 'Hur ofta bör jag gå på behandling för att upprätthålla min hälsa?',
        answer: 'När vi arbetar proaktivt rekommenderar vi ofta glesare, men regelbundna besök för att underhålla kroppens motståndskraft. Allas hälsosituation ser olika ut och därför varierar det från person till person hur ofta man kommer, men det kan vara att man exempelvis kommer på 2-4 besök i månaden.'
    }
];
---

<BaseLayout title="Stärk Din Inre Motståndskraft | Nyköping | Medidraken">
    
    <SymptomHero
        title="Bygg Upp Din Naturliga Motståndskraft"
        subtitle="För En Stark & Stabil Hälsa Året Om"
        image={heroImage}
        imageAlt="Person som utstrålar hälsa och motståndskraft"
        buttonText="Börja Bygga Din Inre Styrka"
        buttonLink="/kontakt?subject=starka-motstandskraften"
    >
        Vill du ge din kropp de bästa förutsättningarna för att hålla sig stark och frisk? 
        Genom att arbeta förebyggande kan vi hjälpa dig att bygga upp din inre energi och motståndskraft. 
        Med akupunktur, TuiNa-massage och stärkande träning skapar vi en stabil grund för din hälsa, 
        så att du kan möta vardagens påfrestningar med ökad vitalitet och styrka.
    </SymptomHero>

    <SymptomMethodsThreeCol
        title="Bygg Din Hälsa Från Grunden"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4 text-center">
            Vi erbjuder flera vägar för att hjälpa dig optimera din inre motståndskraft. Välj det som passar dig bäst.
        </p>
    </SymptomMethodsThreeCol>

    <SymptomCTA
        title="Börja Bygga Din Inre Styrka"
        ctaButtonText="Hör av Dig & Boka Uppstart"
        ctaSubject="starka-motstandskraften"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Ett fritt energiflöde och låga stressnivåer skapar goda förutsättningar för vitalitet 
            och ett starkt inre försvar. Många upplever en skillnad i hälsa och ork efter en period av regelbunden träning/behandling.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor: Så Håller Du Dig Stark & Frisk"
        faqs={faqs}
    />

</BaseLayout>
