---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/ischias_hero4.png';
import tuinaManImage from '../../../assets/images/tuina_man2.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'TuiNa-massage är mycket effektivt för att mjuka upp de djupt liggande muskelspänningar i säte och ländrygg som ofta är den fysiska orsaken till att ischiasnerven hamnar i kläm. Detta ger kroppen goda förutsättningar för minskad smärta samt förbättrad rörlighet och funktion.',
        image: tuinaManImage,
        alt: 'TuiNa-massage för att lösa upp tryck från spända muskler',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur stimulerar och stärker kroppens återhämtningssystem för att ge goda förutsättningar för att minska den utstrålande smärtan.',
        image: acupunctureImage,
        alt: 'Akupunktur vid ischiasbesvär',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    }
];

const faqs = [
    {
        question: 'Finns olika typer av ischiasbesvär?',
        answer: 'Ischiassmärtan kan bero på att ischiasnervens rot är i kläm av en skadad disk i ryggen men kan också bero på nedsatt cirkulation, tryck eller skada närmare höft och ben. Vi har hjälpt många klienter med olika typer av ischiasbesvär.'
    },
    {
        question: 'Kan behandlingen göra det värre i början?',
        answer: 'Efter en djupgående behandling kan du uppleva en tillfällig "återhämtningsvärk" eller ömhet i musklerna likt träningsvärk, vilket är normalt. Själva nervsmärtan brukar dock inte förvärras. Vi för alltid en noggrann dialog med dig för att säkerställa att behandlingen är trygg och anpassad efter din reaktion.'
    },
    {
        question: 'Vad kan jag själv göra för att förebygga så att jag inte får ischiasbesvär igen?',
        answer: 'När vi har minskat den akuta smärtan är det viktigt att du stärker muskulaturen. Regelbunden praktik av Tai Chi och Qigong är utmärkta verktyg för att bygga en stark, balanserad och stabil grund på lång sikt.'
    }
];
---

<BaseLayout title="Behandling vid Ischiasbesvär & Utstrålande Smärta i Nyköping | Medidraken"
  description="Dras du med ischias eller utstrålande smärta i benet? Våra behandlingar i Nyköping & Gnesta hjälper till att lindra trycket på nerven och minska smärta.">
    
    <div class="hero-ischias">
        <SymptomHero
            title="Ischiasbesvär & Utstrålande Smärta"
            subtitle="Minska Smärta & Förbättra Rörligheten"
            image={heroImage}
            imageAlt="Ischias och utstrålande smärta behandling"
            buttonText="Få Hjälp Med Ischiasbesvär"
            buttonLink="/kontakt?subject=ischias"
        >
            Ischiassmärta strålar ofta från ländryggen, ilar genom säte, 
            höft och ben och kan vara oerhört intensivt och begränsande.
            
            Orsaker kan vara längre stillasittande, plötsliga tunga, felaktig belastning eller stress.
            
            Med TCM:s metoder fokuserar vi på att avlasta området och stärka  stärka cirkulationen kring ischiasnerven, 
            vilket ger din kropp goda förutsättningar för minskad smärta och förbättrad rörlighet.
        </SymptomHero>
    </div>

    <SymptomMethods
        title="Hur Vi Arbetar Vid Ischiasbesvär & Utstrålande Smärta"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Vid ischiassmärta är nerven ofta påverkad av tryck från spända muskler i ländrygg och säte samt begränsad cirkulation.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-6">
            Vi erbjuder kompletterande metoder för att hjälpa din kropp släppa dessa spänningar och öka cirkulationen.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Få Hjälp Med Ischiasbesvär"
        ctaButtonText="Hör av Dig & Boka Behandling"
        ctaSubject="ischias"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Vi hjälper dig hitta rätt behandling för din ischiassmärta. Att bli helt frisk kan vara en längre process. Många upplever dock att smärtan börjar minska och rörligheten förbättras inom 3 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Behandling vid Ischiasbesvär"
        faqs={faqs}
    />

</BaseLayout>

<style is:global>
  .hero-ischias .hero-bg-image {
    object-position: 50% 30% !important;
  }
</style>
