---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SymptomHero from '../../../components/symptom/SymptomHero.astro';
import SymptomMethods from '../../../components/symptom/SymptomMethods.astro';
import SymptomCTA from '../../../components/symptom/SymptomCTA.astro';
import SymptomFAQ from '../../../components/symptom/SymptomFAQ.astro';

// Images
import heroImage from '../../../assets/images/hero_ryggont8.png';
import tuinaManImage from '../../../assets/images/tuina_man.png';
import acupunctureImage from '../../../assets/images/aku_doll6.png';

const methods = [
    {
        title: 'TuiNa-massage',
        desc: 'TuiNa-massage är mycket effektivt för att mjuka upp de djupt liggande muskelspänningar i säte och ländrygg som ofta är den fysiska orsaken till att ischiasnerven hamnar i kläm och ger goda förutsättningar för minskad smärta och förbättrad rörlighet och funktion.',
        image: tuinaManImage,
        alt: 'TuiNa-massage för att lösa upp tryck från spända muskler',
        url: '/behandling/tuina-massage/',
        linkText: '→ Läs mer om TuiNa-Massage',
        theme: 'accent' as const
    },
    {
        title: 'Akupunktur',
        desc: 'Akupunktur stimulerar och stärker kroppens energisystem och egna läkningsförmåga för att ge goda förutsättningar för att minska inflammation och utstrålande smärta.',
        image: acupunctureImage,
        alt: 'Akupunktur för ischias och inflammation',
        url: '/behandling/akupunktur/',
        linkText: '→ Läs mer om Akupunktur',
        theme: 'sky' as const
    }
];

const faqs = [
    {
        question: 'Finns olika typer av ischias?',
        answer: 'Ischiassmärtan kan bero på att ischiasnervens rot är i kläm av en skadad disk i ryggen men kan också bero på nedsatt cirkulation, tryck eller skada närmare höft och ben. Vi har hjälpt många klienter med olika typer av ischias.'
    },
    {
        question: 'Kan behandlingen göra det värre i början?',
        answer: 'Efter en djupgående behandling kan du uppleva en tillfällig "återhämtningsvärk" eller ömhet i musklerna likt träningsvärk, vilket är normalt. Själva nervsmärtan brukar dock inte förvärras. Vi för alltid en noggrann dialog med dig för att säkerställa att behandlingen är trygg och anpassad efter din reaktion.'
    },
    {
        question: 'Vad kan jag själv göra för att förebygga så att jag inte får ischias igen?',
        answer: 'När vi har minskat den akuta smärtan är det viktigt att du stärker muskulaturen. Regelbunden praktik av Tai Chi och Qigong är utmärkta verktyg för att bygga en stark, balanserad och stabil grund på lång sikt.'
    }
];
---

<BaseLayout title="Behandling av Ischias & Smärta i Benet i Nyköping | Medidraken">
    
    <SymptomHero
        title="Ischias & Utstrålande Smärta"
        subtitle="Minska Smärta & Förbättra Rörligheten"
        image={heroImage}
        imageAlt="Ischias och utstrålande smärta behandling"
        buttonText="Hör av Dig & Boka Behandling"
        buttonLink="/kontakt"
    >
        Ischiassmärta strålar ofta från ländryggen, ilar genom skinka, 
        höft och ben. Kan vara oerhört intensivt och begränsande.
        
        Orsaker kan vara längre stillasittande, plötsliga tunga, felaktiga belastningar och stress.
        
        Med TCM:s behandlingsmetoder fokuserar vi på att minska trycket och stärka energisystemet kring ischiasnerven så att du får goda förutsättningar för 
        minskad smärta och förbättrad rörlighet.
    </SymptomHero>

    <SymptomMethods
        title="Hur vi Behandlar Ischias & Utstrålande Smärta"
        methods={methods}
    >
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-4">
            Vid ischiassmärta är nerven ofta påverkad av tryck från spända muskler i ländrygg/säte och begränsad cirkulation.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto mb-6">
            Vi erbjuder två kompletterande tillvägagångssätt för att hjälpa din kropp släppa spänningarna och öka cirkulationen. De kan användas var för sig eller i kombination.
        </p>
        <p class="text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
            Hör av dig så hittar vi tillsammans det upplägg som passar dig bäst.
        </p>
    </SymptomMethods>

    <SymptomCTA
        title="Låt Oss Hjälpa Dig med Din Ischias"
        ctaButtonText="Hör av Dig & Boka Behandling"
        ctaSubject="ischias"
    >
        <p class="text-brand-earth-dark text-lg md:text-xl leading-relaxed mb-4">
            Vi hjälper dig hitta rätt behandling för din ischiassmärta. De flesta upplever en märkbar skillnad i smärta och funktion inom 3 behandlingar.
        </p>
    </SymptomCTA>

    <SymptomFAQ
        title="Vanliga Frågor om Behandling av Ischias"
        faqs={faqs}
    />

</BaseLayout>
